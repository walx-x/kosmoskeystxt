local function RenderSettings()
    ClearContent()
    Section("CONFIGURATION MANAGER", "Save and load configurations")

    local StatusLbl = Label(Content, "Status: Ready", 9, Settings.SubText)
    StatusLbl.Size = UDim2.new(1, -5, 0, 16)

    local SaveRow = Create("Frame", { Size = UDim2.new(1, -5, 0, 42), BackgroundColor3 = Settings.Element, BorderSizePixel = 0 }, Content)
    Corner(SaveRow, 8)
    local NameLbl = Label(SaveRow, "Config Name:", 10, Settings.Text)
    NameLbl.Position = UDim2.fromOffset(12, 0)
    NameLbl.Size = UDim2.new(0.4, 0, 1, 0)

    local SaveBox = Create("TextBox", {
        Size = UDim2.fromOffset(150, 28),
        Position = UDim2.new(1, -162, 0.5, -14),
        BackgroundColor3 = Settings.Panel,
        Text = newConfigInputName,
        PlaceholderText = "Name...",
        TextColor3 = Settings.Accent2,
        TextSize = 10,
        Font = Enum.Font.GothamBold
    }, SaveRow)
    Corner(SaveBox, 6)
    Stroke(SaveBox, Settings.Border, 1)
    SaveBox:GetPropertyChangedSignal("Text"):Connect(function() newConfigInputName = SaveBox.Text end)

    ActionButton("SAVE CONFIGURATION", Settings.Accent, function()
        if SaveConfig(newConfigInputName) then
            StatusLbl.Text = "Config saved successfully!"
            StatusLbl.TextColor3 = Settings.Green
        end
    end)

    local DropdownContainer = Create("Frame", { Size = UDim2.new(1, -5, 0, 42), BackgroundColor3 = Settings.Element, BorderSizePixel = 0, ZIndex = 2 }, Content)
    Corner(DropdownContainer, 8)
    local DropTitle = Label(DropdownContainer, "Select Config:", 10, Settings.Text)
    DropTitle.Position = UDim2.fromOffset(12, 0)
    DropTitle.Size = UDim2.new(0.4, 0, 1, 0)

    local DropBtn = Create("TextButton", {
        Size = UDim2.fromOffset(150, 28),
        Position = UDim2.new(1, -162, 0.5, -14),
        BackgroundColor3 = Settings.Panel,
        Text = selectedDropdownConfig ~= "" and selectedDropdownConfig or "Select Config ▼",
        TextColor3 = Settings.Accent2,
        TextSize = 10,
        Font = Enum.Font.GothamBold,
        ZIndex = 3
    }, DropdownContainer)
    Corner(DropBtn, 6)
    Stroke(DropBtn, Settings.Border, 1)

    local DropList = Create("ScrollingFrame", {
        Size = UDim2.new(0, 150, 0, 100),
        Position = UDim2.new(1, -162, 1, 2),
        BackgroundColor3 = Settings.Panel,
        BorderSizePixel = 0,
        Visible = false,
        ZIndex = 50,
        CanvasSize = UDim2.new(0,0,0,0),
        ScrollBarThickness = 2
    }, DropdownContainer)
    Corner(DropList, 6)
    Stroke(DropList, Settings.Border, 1)
    local DropLayout = Create("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder }, DropList)
    DropLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        DropList.CanvasSize = UDim2.new(0,0,0,DropLayout.AbsoluteContentSize.Y)
    end)

    local function RefreshDropdown()
        for _, c in ipairs(DropList:GetChildren()) do
            if c:IsA("TextButton") then c:Destroy() end
        end
        for _, cfgName in ipairs(GetSavedConfigs()) do
            local opt = Create("TextButton", {
                Size = UDim2.new(1, 0, 0, 28),
                BackgroundTransparency = 1,
                Text = cfgName,
                TextColor3 = Settings.Text,
                TextSize = 10,
                Font = Enum.Font.GothamMedium,
                ZIndex = 51
            }, DropList)
            opt.MouseButton1Click:Connect(function()
                selectedDropdownConfig = cfgName
                DropBtn.Text = cfgName
                DropList.Visible = false
                dropdownOpen = false
            end)
        end
    end

    DropBtn.MouseButton1Click:Connect(function()
        dropdownOpen = not dropdownOpen
        if dropdownOpen then RefreshDropdown() end
        DropList.Visible = dropdownOpen
    end)

    ActionButton("LOAD CONFIGURATION", Settings.Panel, function()
        if selectedDropdownConfig ~= "" and LoadConfig(selectedDropdownConfig) then
            StatusLbl.Text = "Config loaded!"
            StatusLbl.TextColor3 = Settings.Green
        end
    end)

    ActionButton("SET AUTOLOAD", Settings.Element, function()
        if selectedDropdownConfig ~= "" then
            SetAutoLoadConfig(selectedDropdownConfig)
            StatusLbl.Text = "Autoload set!"
            StatusLbl.TextColor3 = Settings.Green
        end
    end)

    ActionButton("DELETE CONFIGURATION", Settings.Red, function()
        if selectedDropdownConfig ~= "" and DeleteConfig(selectedDropdownConfig) then
            StatusLbl.Text = "Config deleted!"
            StatusLbl.TextColor3 = Settings.Green
            selectedDropdownConfig = ""
            DropBtn.Text = "Select Config ▼"
        end
    end)

    Section("SCRIPT CONTROLS", "Memory cleanup and unloading")
    ActionButton("UNLOAD SCRIPT", Settings.Red, UnloadScript)
end

SelectPage = function(name)
    for _, btn in ipairs(Navigation:GetChildren()) do
        if btn:IsA("TextButton") then
            local p = btn:GetAttribute("Page")
            local sel = (p == name)
            btn.BackgroundColor3 = sel and Settings.Accent or Settings.Sidebar
        end
    end
    PageTitle.Text = name
    PageSub.Text = "KoSMO / " .. name

    if name == "Dashboard" then RenderDashboard()
    elseif name == "Silent" then RenderSilent()
    elseif name == "Aim Assist" then RenderAimAssist()
    elseif name == "Visuals" then RenderVisuals()
    elseif name == "Movement" then RenderMovement()
    elseif name == "Player" then RenderPlayer()
    elseif name == "Misc" then RenderMisc()
    elseif name == "Settings" then RenderSettings()
    end
end

