local function Toggle(name, default, callback)
    Values[name] = default
    local Row = Create("TextButton", { Size = UDim2.new(1, -5, 0, 42), BackgroundColor3 = Settings.Element, BorderSizePixel = 0, Text = "", AutoButtonColor = false }, Content)
    Corner(Row, 8)

    local Txt = Label(Row, name, 10, Settings.Text)
    Txt.Position = UDim2.fromOffset(12, 0)
    Txt.Size = UDim2.new(1, -70, 1, 0)

    local Switch = Create("Frame", { Size = UDim2.fromOffset(40, 20), Position = UDim2.new(1, -52, 0.5, -10), BackgroundColor3 = default and Settings.Accent or Color3.fromRGB(45, 38, 60), BorderSizePixel = 0 }, Row)
    Corner(Switch, 20)

    local Knob = Create("Frame", { Size = UDim2.fromOffset(14, 14), Position = default and UDim2.new(1, -17, 0.5, -7) or UDim2.new(0, 3, 0.5, -7), BackgroundColor3 = Color3.new(1,1,1), BorderSizePixel = 0 }, Switch)
    Corner(Knob, 14)

    local function updateVisual(ena)
        Values[name] = ena
        Tween(Switch, TweenInfo.new(0.15), { BackgroundColor3 = ena and Settings.Accent or Color3.fromRGB(45, 38, 60) }):Play()
        Tween(Knob, TweenInfo.new(0.15), { Position = ena and UDim2.new(1, -17, 0.5, -7) or UDim2.new(0, 3, 0.5, -7) }):Play()
    end

    ToggleElements[name] = {
        SetState = function(ena)
            updateVisual(ena)
            if callback then callback(ena) end
        end
    }

    Row.MouseButton1Click:Connect(function()
        local newState = not Values[name]
        updateVisual(newState)
        if callback then callback(newState) end
    end)
    RegisterControl(Row, name)
    return Row
end

local function Slider(name, min, max, default, suffix, callback)
    Values[name] = default
    local Row = Create("Frame", { Size = UDim2.new(1, -5, 0, 55), BackgroundColor3 = Settings.Element, BorderSizePixel = 0 }, Content)
    Corner(Row, 8)

    local Txt = Label(Row, name, 10, Settings.Text)
    Txt.Position = UDim2.fromOffset(12, 6)
    Txt.Size = UDim2.new(0.6, 0, 0, 18)

    local Val = Label(Row, tostring(default)..suffix, 10, Settings.Accent2, Enum.Font.GothamBold)
    Val.Position = UDim2.new(0.6, 0, 0, 6)
    Val.Size = UDim2.new(0.4, -12, 0, 18)
    Val.TextXAlignment = Enum.TextXAlignment.Right

    local Bar = Create("TextButton", { Size = UDim2.new(1, -24, 0, 8), Position = UDim2.fromOffset(12, 36), BackgroundColor3 = Color3.fromRGB(45, 38, 60), BorderSizePixel = 0, Text = "" }, Row)
    Corner(Bar, 4)

    local Pct = math.clamp((default - min) / (max - min), 0, 1)
    local Fill = Create("Frame", { Size = UDim2.new(Pct, 0, 1, 0), BackgroundColor3 = Settings.Accent, BorderSizePixel = 0 }, Bar)
    Corner(Fill, 4)

    local Drag = false
    local function Update(input)
        local pos = math.clamp((input.Position.X - Bar.AbsolutePosition.X) / Bar.AbsoluteSize.X, 0, 1)
        local val = math.floor(min + (max - min) * pos)
        Values[name] = val
        Fill.Size = UDim2.new(pos, 0, 1, 0)
        Val.Text = tostring(val)..suffix
        if callback then callback(val) end
    end

    Bar.InputBegan:Connect(function(input) if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then Drag = true Update(input) end end)
    UserInputService.InputEnded:Connect(function(input) if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then Drag = false end end)
    UserInputService.InputChanged:Connect(function(input) if Drag and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then Update(input) end end)
    RegisterControl(Row, name)
    return Row
end

