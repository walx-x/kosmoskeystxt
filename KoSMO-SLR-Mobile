local CONFIG_FOLDER = "KoSMOHub_Configs_Mobile"
local AUTOLOAD_FILE = CONFIG_FOLDER .. "/autoload.txt"

local function EnsureFolder()
    if makefolder and isfolder and not isfolder(CONFIG_FOLDER) then
        makefolder(CONFIG_FOLDER)
    end
end

local function GetSavedConfigs()
    EnsureFolder()
    local configs = {}
    if listfiles then
        local success, files = pcall(function() return listfiles(CONFIG_FOLDER) end)
        if success and files then
            for _, filePath in ipairs(files) do
                if filePath:sub(-5) == ".json" then
                    local fileName = filePath:match("([^/^\\]+)%.json$")
                    if fileName then table.insert(configs, fileName) end
                end
            end
        end
    end
    return configs
end

local function SaveConfig(name)
    EnsureFolder()
    if not writefile or name == "" then return false end
    local configData = {}
    for k, v in pairs(Settings) do
        if typeof(v) == "Color3" then
            configData[k] = {R = v.R, G = v.G, B = v.B, Type = "Color3"}
        elseif typeof(v) == "EnumItem" then
            configData[k] = {Name = v.Name, EnumType = tostring(v.EnumType), Type = "Enum"}
        elseif type(v) ~= "table" then
            configData[k] = v
        end
    end
    return pcall(function()
        writefile(CONFIG_FOLDER .. "/" .. name .. ".json", HttpService:JSONEncode(configData))
    end)
end

local function LoadConfig(name)
    EnsureFolder()
    if not readfile or not isfile then return false end
    local filePath = CONFIG_FOLDER .. "/" .. name .. ".json"
    if not isfile(filePath) then return false end
    local success, result = pcall(function() return HttpService:JSONDecode(readfile(filePath)) end)
    if success and type(result) == "table" then
        for k, v in pairs(result) do
            if Settings[k] ~= nil then
                if type(v) == "table" and v.Type == "Color3" then
                    Settings[k] = Color3.new(v.R, v.G, v.B)
                elseif type(v) == "table" and v.Type == "Enum" then
                    pcall(function() Settings[k] = Enum[v.EnumType][v.Name] end)
                else
                    Settings[k] = v
                end
            end
        end
        return true
    end
    return false
end

local function DeleteConfig(name)
    EnsureFolder()
    if not delfile or not isfile then return false end
    local filePath = CONFIG_FOLDER .. "/" .. name .. ".json"
    if isfile(filePath) then return pcall(function() delfile(filePath) end) end
    return false
end

local function SetAutoLoadConfig(name)
    EnsureFolder()
    if writefile then writefile(AUTOLOAD_FILE, name or "") end
end

local function GetAutoLoadConfig()
    EnsureFolder()
    if isfile and readfile and isfile(AUTOLOAD_FILE) then
        local content = readfile(AUTOLOAD_FILE):gsub("%s+", "")
        if content ~= "" then return content end
    end
    return nil
end

