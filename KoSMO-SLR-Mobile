local function FetchKeyInformation()
    local keyFilePath = "KosmosKey.txt"
    if readfile and isfile and isfile(keyFilePath) then
        local content = readfile(keyFilePath)
        if content then
            ActiveKey = string.gsub(content, "%s+", "")
        end
    end

    if ActiveKey ~= "" and ActiveKey ~= "Not Found" then
        local success, response = pcall(function()
            return game:HttpGet("https://raw.githubusercontent.com/walx-x/kosmoskeystxt/refs/heads/main/KosmosPaidKeys.json")
        end)

        if success and response then
            local jsonSuccess, keysData = pcall(function()
                return HttpService:JSONDecode(response)
            end)

            if jsonSuccess and keysData and keysData[ActiveKey] then
                local keyInfo = keysData[ActiveKey]
                if keyInfo.duration == "lt" or keyInfo.expires_at == nil or keyInfo.expires_at == "null" then
                    KeyExpiration = "Lifetime (Never)"
                else
                    KeyExpiration = tostring(keyInfo.expires_at)
                end
            else
                KeyExpiration = "Valid Mobile Key"
            end
        else
            KeyExpiration = "Bypassed / Connected"
        end
    else
        KeyExpiration = "Active"
    end
end

