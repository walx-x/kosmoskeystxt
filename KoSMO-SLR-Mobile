--============================================================

local function isIgnored(player)
    if player == LocalPlayer then return true end
    if Settings.WhitelistCombatCheck and Settings.Whitelist[player.Name] then return true end
    return false
end

local function isTargetVisible(part, wallCheckEnabled)
    if not wallCheckEnabled then return true end
    local cam = getCamera()
    if not cam then return false end
    return #cam:GetPartsObscuringTarget({part.Position}, {LocalPlayer.Character, part.Parent}) == 0
end

local function getCurrentFOV()
    if not Settings.DynamicFOV then return Settings.BaseFOV end
    local cam = getCamera()
    if not cam then return Settings.BaseFOV end

    local closestDist = math.huge
    for _, player in ipairs(Players:GetPlayers()) do
        if not isIgnored(player) and player.Character then
            local root = player.Character:FindFirstChild("HumanoidRootPart")
            if root then
                local dist = (root.Position - cam.CFrame.Position).Magnitude
                if dist < closestDist then closestDist = dist end
            end
        end
    end
    if closestDist ~= math.huge and closestDist > 0 then
        return math.clamp(Settings.BaseFOV * (50 / closestDist), 12, 220)
    end
    return Settings.BaseFOV
end

local function getBestTarget(maxDistance)
    local cam = getCamera()
    if not cam then return nil, nil end

    local screenCenter = getCenterScreenPosition()
    local bestDist, bestPart, bestScreenPos = maxDistance, nil, nil

    for _, player in ipairs(Players:GetPlayers()) do
        if not isIgnored(player) and player.Character then
            local humanoid = player.Character:FindFirstChildWhichIsA("Humanoid")
            if humanoid and humanoid.Health > 0 then
                local char = player.Character
                if Settings.CustomPart then
                    for _, partName in ipairs(bodyPartsList) do
                        local part = char:FindFirstChild(partName)
                        if part and part:IsA("BasePart") then
                            local screenPos, onScreen = cam:WorldToViewportPoint(part.Position)
                            if onScreen then
                                local screenVec = Vector2.new(screenPos.X, screenPos.Y)
                                local distToCenter = (screenVec - screenCenter).Magnitude
                                if distToCenter <= bestDist and isTargetVisible(part, Settings.WallCheck) then
                                    bestDist = distToCenter
                                    bestPart = part
                                    bestScreenPos = screenVec
                                end
                            end
                        end
                    end
                else
                    local part = char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart")
                    if part then
                        local screenPos, onScreen = cam:WorldToViewportPoint(part.Position)
                        if onScreen then
                            local screenVec = Vector2.new(screenPos.X, screenPos.Y)
                            local distToCenter = (screenVec - screenCenter).Magnitude
                            if distToCenter <= bestDist and isTargetVisible(part, Settings.WallCheck) then
                                bestDist = distToCenter
                                bestPart = part
                                bestScreenPos = screenVec
                            end
                        end
                    end
                end
            end
        end
    end
    return bestPart, bestScreenPos
end

