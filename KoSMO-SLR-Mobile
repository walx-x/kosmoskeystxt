local function AimAt(targetVector2)
    local cam = getCamera()
    if cam then
        local targetWorldPos = cam:ViewportPointToRay(targetVector2.X, targetVector2.Y).Origin
        cam.CFrame = cam.CFrame:Lerp(CFrame.new(cam.CFrame.Position, targetWorldPos), Settings.AimAssistSmoothness)
    end
end

