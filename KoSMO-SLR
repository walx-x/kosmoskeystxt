local function applyWeaponModifiers()
    if not LocalPlayer.Character then return end
    local tool = LocalPlayer.Character:FindFirstChildOfClass("Tool")
    if not tool then return end

    for _, item in ipairs(tool:GetDescendants()) do
        if item:IsA("ModuleScript") then
            local success, content = pcall(function() return require(item) end)
            if success and type(content) == "table" then
                if Settings.NoRecoil then
                    if content.Recoil ~= nil then content.Recoil = 0 end
                    if content.recoil ~= nil then content.recoil = 0 end
                    if content.RecoilControl ~= nil then content.RecoilControl = 0 end
                end
                if Settings.NoSpread then
                    if content.Spread ~= nil then content.Spread = 0 end
                    if content.spread ~= nil then content.spread = 0 end
                    if content.Accuracy ~= nil then content.Accuracy = 1 end
                end
                if Settings.RapidFire then
                    if content.FireRate ~= nil then content.FireRate = 0.02 end
                    if content.fireRate ~= nil then content.fireRate = 0.02 end
                    if content.Cooldown ~= nil then content.Cooldown = 0.02 end
                end
                if Settings.AlwaysAuto then
                    if content.Auto ~= nil then content.Auto = true end
                    if content.Mode ~= nil then content.Mode = "Auto" end
                end
            end
        end
    end
end

