--============================================================
-- COMBAT & TARGETING CALCULATIONS
--============================================================

local function getTargetPart(character, targetName)
    if not character then return nil end
    if targetName == "Torso" then
        return character:FindFirstChild("Torso") or character:FindFirstChild("UpperTorso")
    elseif targetName == "LeftLeg" then
        return character:FindFirstChild("Left Leg") or character:FindFirstChild("LeftUpperLeg")
    elseif targetName == "RightLeg" then
        return character:FindFirstChild("Right Leg") or character:FindFirstChild("RightUpperLeg")
    else
        return character:FindFirstChild(targetName) or character:FindFirstChild("Head")
    end
end

local function isTargetVisible(part)
    if not Settings.WallCheck then return true end
    local cam = getCamera()
    if not cam then return false end
    local ignoreList = {LocalPlayer.Character, part.Parent}
    return #cam:GetPartsObscuringTarget({part.Position}, ignoreList) == 0
end

local function getCurrentFOV()
    if not Settings.DynamicFOV then return Settings.BaseFOV end
    local cam = getCamera()
    if not cam then return Settings.BaseFOV end

    local closestDist = math.huge
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and (not Settings.TeamCheck or player.Team ~= LocalPlayer.Team) then
            local root = player.Character:FindFirstChild("HumanoidRootPart")
            if root then
                local dist = (root.Position - cam.CFrame.Position).Magnitude
                if dist < closestDist then closestDist = dist end
            end
        end
    end
    if closestDist ~= math.huge and closestDist > 0 then
        return math.clamp(Settings.BaseFOV * (50 / closestDist), 12, 220)
    end
    return Settings.BaseFOV
end

local function getBestTarget(maxDistance)
    local cam = getCamera()
    if not cam then return nil, nil end

    local mousePos = getMousePosition()
    local bestDist, bestPart, bestScreenPos = maxDistance, nil, nil
    local targetName = Settings.HitPatternEnabled and hitPattern[currentPatternIndex] or Settings.TargetBone

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and (not Settings.TeamCheck or player.Team ~= LocalPlayer.Team) then
            local humanoid = player.Character:FindFirstChildWhichIsA("Humanoid")
            if humanoid and humanoid.Health > 0 then
                local part = getTargetPart(player.Character, targetName)
                if part then
                    local screenPos, onScreen = cam:WorldToViewportPoint(part.Position)
                    if onScreen then
                        local screenVec = Vector2.new(screenPos.X, screenPos.Y)
                        local distToMouse = (screenVec - mousePos).Magnitude
                        if distToMouse < bestDist and isTargetVisible(part) then
                            bestDist = distToMouse
                            bestPart = part
                            bestScreenPos = screenVec
                        end
                    end
                end
            end
        end
    end
    return bestPart, bestScreenPos
end

