--============================================================
-- TARGETING & VISUALS ENGINE
--============================================================

local function getTargetPart(character, targetName)
    if not character then return nil end
    if targetName == "Torso" then
        return character:FindFirstChild("Torso") or character:FindFirstChild("UpperTorso")
    elseif targetName == "LeftLeg" then
        return character:FindFirstChild("Left Leg") or character:FindFirstChild("LeftUpperLeg")
    elseif targetName == "RightLeg" then
        return character:FindFirstChild("Right Leg") or character:FindFirstChild("RightUpperLeg")
    else
        return character:FindFirstChild(targetName) or character:FindFirstChild("Head")
    end
end

local function isTargetVisible(part)
    if not Settings.WallCheck then return true end
    local cam = getCamera()
    if not cam then return false end
    local ignoreList = {LocalPlayer.Character, part.Parent}
    local parts = cam:GetPartsObscuringTarget({part.Position}, ignoreList)
    return #parts == 0
end

local function getCurrentFOV()
    if not Settings.DynamicFOV then return Settings.BaseFOV end
    local cam = getCamera()
    if not cam then return Settings.BaseFOV end

    local closestWorldDist = math.huge
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            if not Settings.TeamCheck or player.Team ~= LocalPlayer.Team then
                local root = player.Character:FindFirstChild("HumanoidRootPart")
                if root then
                    local worldDist = (root.Position - cam.CFrame.Position).Magnitude
                    if worldDist < closestWorldDist then closestWorldDist = worldDist end
                end
            end
        end
    end

    if closestWorldDist ~= math.huge and closestWorldDist > 0 then
        local scaled = Settings.BaseFOV * (50 / closestWorldDist)
        return math.clamp(scaled, 12, 220)
    end
    return Settings.BaseFOV
end

local function getBestTarget(maxDistance)
    local cam = getCamera()
    if not cam then return nil, nil end

    local mousePos = getMousePosition()
    local bestDist = maxDistance
    local bestPart = nil
    local bestScreenPos = nil
    
    local targetName = Settings.HitPatternEnabled and hitPattern[currentPatternIndex] or Settings.TargetBone

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            if not Settings.TeamCheck or player.Team ~= LocalPlayer.Team then
                local humanoid = player.Character:FindFirstChildWhichIsA("Humanoid")
                if humanoid and humanoid.Health > 0 then
                    local part = getTargetPart(player.Character, targetName)
                    if part then
                        local screenPos, onScreen = cam:WorldToViewportPoint(part.Position)
                        if onScreen then
                            local screenVec = Vector2.new(screenPos.X, screenPos.Y)
                            local distToMouse = (screenVec - mousePos).Magnitude
                            
                            if distToMouse < bestDist and isTargetVisible(part) then
                                bestDist = distToMouse
                                bestPart = part
                                bestScreenPos = screenVec
                            end
                        end
                    end
                end
            end
        end
    end
    return bestPart, bestScreenPos
end

local function updateESP()
    espFolder:ClearAllChildren()
    if not Settings.ESPEnabled then return end

    local cam = getCamera()
    if not cam then return end

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
            if not Settings.TeamCheck or player.Team ~= LocalPlayer.Team then
                local char = player.Character
                local root = char:FindFirstChild("HumanoidRootPart")
                local humanoid = char:FindFirstChildWhichIsA("Humanoid")

                if root and humanoid and humanoid.Health > 0 then
                    if Settings.ESPChams then
                        local highlight = Instance.new("Highlight")
                        highlight.Adornee = char
                        highlight.FillColor = Settings.ChamColor
                        highlight.FillTransparency = 0.5
                        highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
                        highlight.OutlineTransparency = 0
                        highlight.Parent = espFolder
                    end

                    if Settings.ESPBoxes or Settings.ESPNames or Settings.ESPDistance or Settings.ESPHealth then
                        local bb = Instance.new("BillboardGui")
                        bb.Adornee = root
                        bb.Size = UDim2.new(4.5, 0, 5.5, 0)
                        bb.AlwaysOnTop = true
                        bb.Parent = espFolder

                        if Settings.ESPBoxes then
                            local box = Instance.new("Frame")
                            box.Size = UDim2.new(1, 0, 1, 0)
                            box.BackgroundTransparency = 1
                            box.BorderSizePixel = 0
                            box.Parent = bb
                            Stroke(box, Settings.ESPColor, 1.5, 0)
                        end

                        if Settings.ESPNames or Settings.ESPDistance then
                            local textStr = ""
                            if Settings.ESPNames then textStr = player.Name end
                            if Settings.ESPDistance then
                                local dist = math.floor((root.Position - cam.CFrame.Position).Magnitude)
                                textStr = textStr .. " [" .. tostring(dist) .. "m]"
                            end

                            local nameLbl = Instance.new("TextLabel")
                            nameLbl.Size = UDim2.new(1, 0, 0, 15)
                            nameLbl.Position = UDim2.new(0, 0, 0, -18)
                            nameLbl.BackgroundTransparency = 1
                            nameLbl.Text = textStr
                            nameLbl.TextColor3 = Color3.fromRGB(255, 255, 255)
                            nameLbl.TextSize = 10
                            nameLbl.Font = Enum.Font.GothamBold
                            nameLbl.Parent = bb
                        end

                        if Settings.ESPHealth then
                            local healthBg = Instance.new("Frame")
                            healthBg.Size = UDim2.new(0, 4, 1, 0)
                            healthBg.Position = UDim2.new(0, -8, 0, 0)
                            healthBg.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
                            healthBg.BorderSizePixel = 0
                            healthBg.Parent = bb

                            local healthPct = math.clamp(humanoid.Health / humanoid.MaxHealth, 0, 1)
                            local healthFill = Instance.new("Frame")
                            healthFill.Size = UDim2.new(1, 0, healthPct, 0)
                            healthFill.Position = UDim2.new(0, 0, 1 - healthPct, 0)
                            healthFill.BackgroundColor3 = Settings.Red:Lerp(Settings.Green, healthPct)
                            healthFill.BorderSizePixel = 0
                            healthFill.Parent = healthBg
                        end
                    end
                end
            end
        end
    end
end

renderConnection = RunService.RenderStepped:Connect(function()
    if Settings.RainbowFOV then
        local hue = (tick() % 5) / 5
        Settings.FOVColor = Color3.fromHSV(hue, 0.8, 1)
    end

    if Settings.Fullbright then
        Lighting.Ambient = Color3.fromRGB(255, 255, 255)
        Lighting.Brightness = 2
        Lighting.GlobalShadows = false
    end

    CrosshairFrame.Visible = Settings.Crosshair

    local activeFOV = getCurrentFOV()
    local mousePos = getMousePosition()

    if Settings.Enabled and Settings.ShowFOV then
        FOVFrame.Visible = true
        FOVFrame.Size = UDim2.new(0, activeFOV * 2, 0, activeFOV * 2)
        FOVFrame.Position = UDim2.new(0, mousePos.X, 0, mousePos.Y)
        FOVStroke.Color = Settings.FOVColor
    else
        FOVFrame.Visible = false
    end

    local bestPart, bestScreenPos = getBestTarget(activeFOV)
    if Settings.Enabled and Settings.ShowDot and bestScreenPos then
        TargetDotFrame.Visible = true
        TargetDotFrame.Position = UDim2.new(0, bestScreenPos.X, 0, bestScreenPos.Y)
        TargetDotFrame.BackgroundColor3 = Settings.TargetColor
    else
        TargetDotFrame.Visible = false
    end

    updateESP()
end)

pcall(function()
    SimpleCastModule = require(ReplicatedStorage:FindFirstChild("SimpleCast", true))
    if SimpleCastModule and SimpleCastModule.Fire then
        oldFire = SimpleCastModule.Fire
        SimpleCastModule.Fire = function(self, origin, direction, speed, options)
            if Settings.Enabled then
                local roll = math.random(1, 100)
                if roll <= Settings.HitProbability then
                    local activeFOV = getCurrentFOV()
                    local targetPart, _ = getBestTarget(activeFOV)
                    if targetPart then
                        direction = (targetPart.Position - origin).Unit
                        if Settings.HitPatternEnabled then
                            currentPatternIndex = (currentPatternIndex % #hitPattern) + 1
                        end
                    end
                end
            end
            return oldFire(self, origin, direction, speed, options)
        end
    end
end)

local function UnloadScript()
    if renderConnection then renderConnection:Disconnect() end
    if inputConnection then inputConnection:Disconnect() end
    if SimpleCastModule and oldFire then SimpleCastModule.Fire = oldFire end
    
    Lighting.Ambient = origAmbient
    Lighting.Brightness = origBrightness
    Lighting.GlobalShadows = origShadows

    if espFolder then espFolder:Destroy() end
    if ScreenGui then ScreenGui:Destroy() end
end

