    end)
end

-- FULL SETTINGS CATEGORY
local function RenderSettings()
    ClearContent()

    local StatusLbl = Label(Content, "Stato: In attesa di azioni...", 9, Settings.SubText)
    StatusLbl.Size = UDim2.new(1, -5, 0, 18)

    Section("1. CRIA O AGGIORNA CONFIGURAZIONE", "Salva le attuali impostazioni in un file salvato")

    local SaveRow = Create("Frame", { Size = UDim2.new(1,-5,0,45), BackgroundColor3 = Settings.Element, BorderSizePixel = 0 }, Content)
    Corner(SaveRow, 6)
    
    local NameLabel = Label(SaveRow, "Nome Configurazione:", 10, Settings.Text)
    NameLabel.Position = UDim2.fromOffset(12, 0)
    NameLabel.Size = UDim2.new(0.4, 0, 1, 0)

    local SaveNameBox = Create("TextBox", {
        Size = UDim2.fromOffset(180, 28),
        Position = UDim2.new(1, -192, 0.5, -14),
        BackgroundColor3 = Settings.Panel,
        Text = newConfigInputName,
        PlaceholderText = "Nome config...",
        TextColor3 = Settings.Accent2,
        TextSize = 10,
        Font = Enum.Font.GothamBold
    }, SaveRow)
    Corner(SaveNameBox, 5)
    Stroke(SaveNameBox, Settings.Border, 1)

    SaveNameBox:GetPropertyChangedSignal("Text"):Connect(function()
        newConfigInputName = SaveNameBox.Text
    end)

    ActionButton("SALVA NUOVA CONFIGURAZIONE", Settings.Accent, function()
        if newConfigInputName == "" then
            StatusLbl.Text = "Errore: Inserisci un nome valido!"
            StatusLbl.TextColor3 = Settings.Red
            return
        end

        if SaveConfig(newConfigInputName) then
            StatusLbl.Text = "Configurazione '" .. newConfigInputName .. "' salvata con successo!"
            StatusLbl.TextColor3 = Settings.Green
            SelectPage("Settings")
        end
    end)

    Section("2. GESTIONE FILE DI CONFIGURAZIONE", "Seleziona, carica, esegui all'avvio o elimina")

    local savedList = GetSavedConfigs()
    if #savedList > 0 and selectedDropdownConfig == "" then
        selectedDropdownConfig = savedList[1]
    end

    local DropdownContainer = Create("Frame", { Size = UDim2.new(1,-5,0,45), BackgroundColor3 = Settings.Element, BorderSizePixel = 0 }, Content)
    Corner(DropdownContainer, 6)

    local DropTitle = Label(DropdownContainer, "Config Selezionata:", 10, Settings.Text)
    DropTitle.Position = UDim2.fromOffset(12, 0)
    DropTitle.Size = UDim2.new(0.4, 0, 1, 0)

    local DropBtn = Create("TextButton", {
        Size = UDim2.fromOffset(180, 28),
        Position = UDim2.new(1, -192, 0.5, -14),
        BackgroundColor3 = Settings.Panel,
        Text = selectedDropdownConfig ~= "" and (selectedDropdownConfig .. "  ▼") or "Nessuna Config Found  ▼",
        TextColor3 = Settings.Accent2,
        TextSize = 10,
        Font = Enum.Font.GothamBold
    }, DropdownContainer)
    Corner(DropBtn, 5)
    Stroke(DropBtn, Settings.Border, 1)

    ActionButton("CARICA CONFIGURAZIONE SELEZIONATA", Settings.Panel, function()
        if selectedDropdownConfig ~= "" and LoadConfig(selectedDropdownConfig) then
            StatusLbl.Text = "Configurazione '" .. selectedDropdownConfig .. "' caricata!"
            StatusLbl.TextColor3 = Settings.Green
            SelectPage("Settings")
        end
    end)

    ActionButton("IMPOSTA AUTOLOAD ALL'AVVIO", Settings.Element, function()
        if selectedDropdownConfig ~= "" then
            SetAutoLoadConfig(selectedDropdownConfig)
            StatusLbl.Text = "AutoLoad impostato su '" .. selectedDropdownConfig .. "'!"
            StatusLbl.TextColor3 = Settings.Green
            SelectPage("Settings")
        end
    end)

    ActionButton("ELIMINA CONFIGURAZIONE", Settings.Red, function()
        if selectedDropdownConfig ~= "" and DeleteConfig(selectedDropdownConfig) then
            StatusLbl.Text = "Configurazione eliminata con successo!"
            StatusLbl.TextColor3 = Settings.Green
            selectedDropdownConfig = ""
            SelectPage("Settings")
        end
    end)

    Section("3. KEYBINDS E AMBIENTE", "Tasti rapidi e controllo dello script")
    Keybind("Tasto Apertura/Chiusura Menu", Settings.ToggleKey, function(key) Settings.ToggleKey = key end)
    Keybind("Tasto Unload Script Rapido", Settings.UnloadKey, function(key) Settings.UnloadKey = key end)
    
    Slider("Scala Dimensione Interfaccia (UI Scale)", 8, 15, math.floor(Settings.UIScale * 10), "x", function(v)
        Settings.UIScale = v / 10
        MainScale.Scale = Settings.UIScale
    end)

    ActionButton("UNLOAD & RIMUOVI SCRIPT DALLA MEMORIA", Settings.Red, UnloadScript)
end

SelectPage = function(name)
    CurrentPage = name
    for _, button in ipairs(Navigation:GetChildren()) do
        if button:IsA("TextButton") then
            local page = button:GetAttribute("Page")
            local isSel = (page == name)
            button.BackgroundColor3 = isSel and Settings.Accent or Settings.Sidebar
            local icon = button:FindFirstChild("IconImage")
            local text = button:FindFirstChild("Text")
            if icon then icon.ImageColor3 = isSel and Color3.new(1,1,1) or Settings.SubText end
            if text then text.TextColor3 = isSel and Color3.new(1,1,1) or Settings.SubText end
        end
    end

    PageTitle.Text = name
    PageSub.Text = "KOSMOS / " .. string.upper(name)

    if name == "Dashboard" then RenderDashboard()
    elseif name == "Combat" then RenderCombat()
    elseif name == "Visuals" then RenderVisuals()
    elseif name == "Movement" then RenderMovement()
    elseif name == "Weapon" then RenderWeapon()
    elseif name == "Player" then RenderPlayer()
    elseif name == "Misc" then RenderMisc()
    elseif name == "Settings" then RenderSettings()
    end
end

