-- Universal Gun Engine Hooking
pcall(function()
    SimpleCastModule = require(ReplicatedStorage:FindFirstChild("SimpleCast", true))
    if SimpleCastModule and SimpleCastModule.Fire then
        oldFire = SimpleCastModule.Fire
        SimpleCastModule.Fire = function(self, origin, direction, speed, options)
            if Settings.Enabled then
                local roll = math.random(1, 100)
                if roll <= Settings.HitProbability then
                    local activeFOV = getCurrentFOV()
                    local targetPart, _ = getBestTarget(activeFOV)
                    if targetPart then
                        direction = (targetPart.Position - origin).Unit
                        if Settings.HitPatternEnabled then
                            currentPatternIndex = (currentPatternIndex % #hitPattern) + 1
                        end
                    end
                end
            end
            return oldFire(self, origin, direction, speed, options)
        end
    end
end)

