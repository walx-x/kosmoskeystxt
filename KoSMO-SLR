    Value.Size = UDim2.new(0.4,-12,0,20)
    Value.TextXAlignment = Enum.TextXAlignment.Right

    local Bar = Create("TextButton", { Size = UDim2.new(1,-24,0,5), Position = UDim2.fromOffset(12,40), BackgroundColor3 = Color3.fromRGB(45,40,53), BorderSizePixel = 0, Text = "" }, Row)
    Corner(Bar, 5)

    local Percentage = math.clamp((default-min)/(max-min), 0, 1)
    local Fill = Create("Frame", { Size = UDim2.new(Percentage,0,1,0), BackgroundColor3 = Settings.Accent, BorderSizePixel = 0 }, Bar)
    Corner(Fill, 5)

    local Dragging = false
    local function Update(input)
        local position = math.clamp((input.Position.X-Bar.AbsolutePosition.X)/Bar.AbsoluteSize.X, 0, 1)
        local value = math.floor(min+(max-min)*position)
        Values[name] = value
        Fill.Size = UDim2.new(position,0,1,0)
        Value.Text = tostring(value)..suffix
        if callback then callback(value) end
    end

    Bar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then Dragging = true Update(input) end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then Dragging = false end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if Dragging and input.UserInputType == Enum.UserInputType.MouseMovement then Update(input) end
    end)
    RegisterControl(Row, name)
    return Row
end

local function Keybind(name, defaultKey, callback)
    Values[name] = defaultKey
    local Row = Create("Frame", { Size = UDim2.new(1,-5,0,45), BackgroundColor3 = Settings.Element, BorderSizePixel = 0 }, Content)
    Corner(Row, 6)

    local Title = Label(Row, name, 10, Settings.Text)
    Title.Position = UDim2.fromOffset(12,0)
    Title.Size = UDim2.new(0.6,0,1,0)

    local Button = Create("TextButton", {
        Size = UDim2.fromOffset(110,28),
        Position = UDim2.new(1,-122,0.5,-14),
        BackgroundColor3 = Settings.Panel,
        BorderSizePixel = 0,
        Text = defaultKey and defaultKey.Name or "NONE",
        TextColor3 = Settings.Accent2,
        TextSize = 9,
        Font = Enum.Font.GothamBold
    }, Row)
    Corner(Button, 5)
    Stroke(Button, Settings.Border, 1)

    local Listening = false
    Button.MouseButton1Click:Connect(function()
        Listening = true
        Button.Text = "PRESS KEY..."
    end)

    UserInputService.InputBegan:Connect(function(input)
        if Listening and input.UserInputType == Enum.UserInputType.Keyboard then
            Values[name] = input.KeyCode
            Button.Text = input.KeyCode.Name
            Listening = false
            if callback then callback(input.KeyCode) end
        end
    end)
    RegisterControl(Row, name)
    return Row
end

local function ActionButton(name, color, callback)
    local Button = Create("TextButton", {
        Size = UDim2.new(1,-5,0,44),
        BackgroundColor3 = color or Settings.Accent,
        BorderSizePixel = 0,
        Text = name,
        TextColor3 = Color3.new(1,1,1),
        TextSize = 10,
        Font = Enum.Font.GothamBold
    }, Content)
    Corner(Button, 7)
    Button.MouseButton1Click:Connect(callback)
    RegisterControl(Button, name)
    return Button
end

