local function updateESP()
    espFolder:ClearAllChildren()
    tracerFolder:ClearAllChildren()
    if not Settings.ESPEnabled then return end

    local cam = getCamera()
    if not cam then return end

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            if not Settings.TeamCheck or player.Team ~= LocalPlayer.Team then
                local char = player.Character
                local root = char:FindFirstChild("HumanoidRootPart")
                local humanoid = char:FindFirstChildWhichIsA("Humanoid")

                if root and humanoid and humanoid.Health > 0 then
                    local head = char:FindFirstChild("Head") or root
                    local headPos, onScreen1 = cam:WorldToViewportPoint(head.Position + Vector3.new(0, 1.2, 0))
                    local legPos, onScreen2 = cam:WorldToViewportPoint(root.Position - Vector3.new(0, 3.2, 0))

                    if onScreen1 or onScreen2 then
                        local boxHeight = math.abs(headPos.Y - legPos.Y)
                        local boxWidth = boxHeight * 0.65
                        local boxPosX = headPos.X - (boxWidth / 2)
                        local boxPosY = headPos.Y

                        -- 1. Tracers
                        if Settings.ESPTracers then
                            local line = Instance.new("Frame")
                            line.BorderSizePixel = 0
                            line.BackgroundColor3 = Settings.TracerColor
                            line.AnchorPoint = Vector2.new(0.5, 0.5)

                            local startPos = Vector2.new(cam.ViewportSize.X / 2, cam.ViewportSize.Y)
                            local targetVec = Vector2.new(headPos.X, legPos.Y)
                            local distance = (targetVec - startPos).Magnitude
                            local angle = math.atan2(targetVec.Y - startPos.Y, targetVec.X - startPos.X)

                            line.Size = UDim2.new(0, distance, 0, 1.5)
                            line.Position = UDim2.new(0, (startPos.X + targetVec.X) / 2, 0, (startPos.Y + targetVec.Y) / 2)
                            line.Rotation = math.deg(angle)
                            line.Parent = tracerFolder
                        end

                        -- 2. Chams Highlight
                        if Settings.ESPChams then
                            local highlight = Instance.new("Highlight")
                            highlight.Adornee = char
                            highlight.FillColor = Settings.ChamColor
                            highlight.FillTransparency = 0.5
                            highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
                            highlight.OutlineTransparency = 0
                            highlight.Parent = espFolder
                        end

                        -- 3. 2D Bounding Box
                        if Settings.ESPBoxes then
                            local box = Instance.new("Frame")
                            box.Size = UDim2.fromOffset(boxWidth, boxHeight)
                            box.Position = UDim2.fromOffset(boxPosX, boxPosY)
                            box.BackgroundTransparency = 1
                            box.Parent = espFolder
                            Stroke(box, Settings.ESPColor, 1.5, 0)
                        end

                        -- 4. Player Name
                        if Settings.ESPNames then
                            local nameLbl = Instance.new("TextLabel")
                            nameLbl.Size = UDim2.fromOffset(200, 16)
                            nameLbl.Position = UDim2.fromOffset(headPos.X - 100, boxPosY - 18)
                            nameLbl.BackgroundTransparency = 1
                            nameLbl.Text = player.DisplayName .. " (@" .. player.Name .. ")"
                            nameLbl.TextColor3 = Color3.fromRGB(255, 255, 255)
                            nameLbl.TextSize = 11
                            nameLbl.Font = Enum.Font.GothamBold
                            nameLbl.TextStrokeTransparency = 0.2
                            nameLbl.TextXAlignment = Enum.TextXAlignment.Center
                            nameLbl.Parent = espFolder
                        end

                        -- 5. Distance Indicator
                        if Settings.ESPDistance then
                            local dist = math.floor((root.Position - cam.CFrame.Position).Magnitude)
                            local distLbl = Instance.new("TextLabel")
                            distLbl.Size = UDim2.fromOffset(200, 14)
                            distLbl.Position = UDim2.fromOffset(headPos.X - 100, boxPosY + boxHeight + 2)
                            distLbl.BackgroundTransparency = 1
                            distLbl.Text = "[" .. tostring(dist) .. "m]"
                            distLbl.TextColor3 = Settings.Accent2
                            distLbl.TextSize = 10
                            distLbl.Font = Enum.Font.GothamBold
                            distLbl.TextStrokeTransparency = 0.2
                            distLbl.TextXAlignment = Enum.TextXAlignment.Center
                            distLbl.Parent = espFolder
                        end

                        -- 6. Health Bar
                        if Settings.ESPHealth then
                            local healthPct = math.clamp(humanoid.Health / humanoid.MaxHealth, 0, 1)
                            local barHeight = boxHeight * healthPct

                            local healthBg = Instance.new("Frame")
                            healthBg.Size = UDim2.fromOffset(4, boxHeight)
                            healthBg.Position = UDim2.fromOffset(boxPosX - 7, boxPosY)
                            healthBg.BackgroundColor3 = Color3.fromRGB(20, 18, 25)
                            healthBg.BorderSizePixel = 0
                            healthBg.Parent = espFolder
                            Corner(healthBg, 2)

                            local healthFill = Instance.new("Frame")
                            healthFill.Size = UDim2.fromOffset(4, barHeight)
                            healthFill.Position = UDim2.fromOffset(boxPosX - 7, boxPosY + (boxHeight - barHeight))
                            healthFill.BackgroundColor3 = Settings.Red:Lerp(Settings.Green, healthPct)
                            healthFill.BorderSizePixel = 0
                            healthFill.Parent = espFolder
                            Corner(healthFill, 2)
                        end
                    end
                end
            end
        end
    end
end

