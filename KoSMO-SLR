steppedConnection = RunService.Stepped:Connect(function()
    if LocalPlayer.Character then
        local humanoid = LocalPlayer.Character:FindFirstChildWhichIsA("Humanoid")
        local root = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")

        if humanoid then
            if Settings.EnableWalkSpeed then humanoid.WalkSpeed = Settings.WalkSpeed end
            if Settings.EnableJumpPower then humanoid.UseJumpPower = true; humanoid.JumpPower = Settings.JumpPower end
            if Settings.EnableHipHeight then humanoid.HipHeight = Settings.CustomHipHeight end
            if Settings.BHop and humanoid.FloorMaterial ~= Enum.Material.Air and humanoid.MoveDirection.Magnitude > 0 then
                humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
            end
        end

        -- Camera FOV Modification
        local cam = getCamera()
        if cam and Settings.EnableCustomFOV then
            cam.FieldOfView = Settings.CustomFOV
        end

        -- CFrame Fly System
        if Settings.FlyEnabled and root then
            local flyVec = Vector3.zero
            if UserInputService:IsKeyDown(Enum.KeyCode.W) then flyVec = flyVec + cam.CFrame.LookVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.S) then flyVec = flyVec - cam.CFrame.LookVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.A) then flyVec = flyVec - cam.CFrame.RightVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.D) then flyVec = flyVec + cam.CFrame.RightVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.Space) then flyVec = flyVec + Vector3.yAxis end
            if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then flyVec = flyVec - Vector3.yAxis end

            root.Velocity = Vector3.zero
            if flyVec.Magnitude > 0 then
                root.CFrame = root.CFrame + (flyVec.Unit * (Settings.FlySpeed / 10))
            end
        end

        -- Spinbot Anti-Aim
        if Settings.Spinbot and root then
            root.CFrame = root.CFrame * CFrame.Angles(0, math.rad(Settings.SpinSpeed), 0)
        end

        -- Ghost Mode / Transparency
        for _, part in ipairs(LocalPlayer.Character:GetDescendants()) do
            if part:IsA("BasePart") then
                if Settings.Noclip or Settings.FlyEnabled then
                    part.CanCollide = false
                end
                if Settings.GhostMode and part.Name ~= "HumanoidRootPart" then
                    part.LocalTransparencyModifier = 0.6
                end
            end
        end
    end
end)

