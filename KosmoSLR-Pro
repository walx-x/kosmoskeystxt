function Fn.EvaluatePlayerAdonisRank(player)
    if not player or not player.Parent then return nil end

    local keywords = {
        "mod", "moderator", "admin", "administrator", "headadmin", "head admin",
        "creator", "owner", "co-owner", "coowner", "founder", "dev", "developer",
        "staff", "trial", "helper", "support", "manager", "supervisor", "overseer",
        "enforcer", "director", "executive", "intern", "hr", "high rank"
    }

    local function matchesKw(str)
        if not str or str == "" then return false end
        local low = str:lower()
        for _, kw in ipairs(keywords) do
            if low:find(kw, 1, true) then return true end
        end
        return false
    end

    local function mapTier(rankNum, roleStr)
        local low = (roleStr or ""):lower()
        if low:find("creator") or low:find("owner") or low:find("founder") or rankNum >= 250 then
            return "Creators (900)"
        elseif low:find("head") or low:find("director") or low:find("manager") or rankNum >= 200 then
            return "HeadAdmins (300)"
        elseif low:find("admin") or low:find("dev") or rankNum >= 150 then
            return "Admins (200)"
        else
            return "Moderators (100)"
        end
    end

    if game.CreatorType == Enum.CreatorType.User and player.UserId == game.CreatorId then
        return { Name = player.Name, DisplayName = player.DisplayName, AdonisRank = "Creators (900)", RoleDetail = "Game Owner" }
    end

    if game.CreatorType == Enum.CreatorType.Group and game.CreatorId > 0 then
        local okRank, rankNum = pcall(function() return player:GetRankInGroup(game.CreatorId) end)
        local okRole, roleStr = pcall(function() return player:GetRoleInGroup(game.CreatorId) end)
        rankNum = (okRank and type(rankNum) == "number") and rankNum or 0
        roleStr = (okRole and type(roleStr) == "string") and roleStr or ""

        if rankNum >= Settings.AdminMinGroupRank or matchesKw(roleStr) then
            return {
                Name = player.Name,
                DisplayName = player.DisplayName,
                AdonisRank = mapTier(rankNum, roleStr),
                RoleDetail = string.format("%s [%d]", roleStr ~= "" and roleStr or "Staff", rankNum)
            }
        end
    end

    local okAttr, attrs = pcall(function() return player:GetAttributes() end)
    if okAttr and type(attrs) == "table" then
        for k, v in pairs(attrs) do
            local lk = tostring(k):lower()
            if lk:find("admin") or lk:find("adonis") or lk:find("rank") or lk:find("staff") or lk:find("role") then
                if type(v) == "number" and v >= 100 then
                    return { Name = player.Name, DisplayName = player.DisplayName, AdonisRank = mapTier(v, tostring(k)), RoleDetail = string.format("Attr %s: %d", tostring(k), v) }
                elseif type(v) == "string" and matchesKw(v) then
                    return { Name = player.Name, DisplayName = player.DisplayName, AdonisRank = mapTier(100, v), RoleDetail = string.format("%s (%s)", v, tostring(k)) }
                elseif v == true and (lk:find("admin") or lk:find("mod") or lk:find("staff")) then
                    return { Name = player.Name, DisplayName = player.DisplayName, AdonisRank = "Moderators (100)", RoleDetail = tostring(k) }
                end
            end
        end
    end

    local ls = player:FindFirstChild("leaderstats")
    if ls then
        for _, child in ipairs(ls:GetChildren()) do
            if child:IsA("StringValue") and matchesKw(child.Value) then
                return { Name = player.Name, DisplayName = player.DisplayName, AdonisRank = mapTier(100, child.Value), RoleDetail = child.Value }
            elseif (child:IsA("IntValue") or child:IsA("NumberValue")) then
                local cname = child.Name:lower()
                if (cname:find("admin") or cname:find("rank") or cname:find("level")) and child.Value >= 100 then
                    return { Name = player.Name, DisplayName = player.DisplayName, AdonisRank = mapTier(child.Value, child.Name), RoleDetail = string.format("%s: %d", child.Name, child.Value) }
                end
            end
        end
    end

    if typeof(getgc) == "function" then
        local foundFromGC = nil
        pcall(function()
            for _, obj in ipairs(getgc(true)) do
                if type(obj) == "table" then
                    local lvl = rawget(obj, "AdminLevel") or rawget(obj, "Level")
                    local user = rawget(obj, "Player") or rawget(obj, "UserId")
                    if type(lvl) == "number" and lvl >= 100 and (user == player or user == player.UserId) then
                        foundFromGC = { Name = player.Name, DisplayName = player.DisplayName, AdonisRank = mapTier(lvl, ""), RoleDetail = "Adonis Level " .. tostring(lvl) }
                        break
                    end
                end
            end
        end)
        if foundFromGC then return foundFromGC end
    end

    return nil
end

function Fn.InspectPlayerForAdmin(player, silentInit)
    if not Settings.AdminDetector or not player or player == LocalPlayer then return end
    task.spawn(function()
        local info = Fn.EvaluatePlayerAdonisRank(player)
        if info and player.Parent then
            local alreadyKnown = State.DetectedAdmins[player] ~= nil
            State.DetectedAdmins[player] = info

            if not alreadyKnown then
                if Settings.AdminAlertSound then
                    local s = Instance.new("Sound")
                    s.SoundId = AssetsCfg.ADMIN_ALERT_SOUND_ID
                    s.Volume = 1
                    s.Parent = UI.ScreenGui
                    s:Play()
                    task.delay(2, function() if s then s:Destroy() end end)
                end

                Fn.Notify("⚠ ADONIS STAFF DETECTED", string.format("%s (@%s) — %s", info.DisplayName, info.Name, info.RoleDetail), true, true)

                if Settings.AdminAutoPanic and not State.PanicActive and Fn.TogglePanicMode then
                    Fn.TogglePanicMode()
                end

                if Settings.AdminAutoLeave and not silentInit then
                    task.wait(0.35)
                    LocalPlayer:Kick("\n[KoSMO Admin Detector]\nAdonis Staff Joined: " .. info.Name .. " (" .. info.RoleDetail .. ")")
                end
            end
        end
    end)
end

function Fn.ScanAllPlayersForAdmin(manualTrigger)
    table.clear(State.DetectedAdmins)
    for _, plr in ipairs(Players:GetPlayers()) do
        Fn.InspectPlayerForAdmin(plr, not manualTrigger)
    end
    if manualTrigger then
        task.delay(0.5, function()
            local total = Fn.CountDetectedAdmins()
            Fn.Notify("Adonis Detector", total > 0 and (total .. " staff member(s) found in server") or "No Adonis staff detected", true, total > 0)
        end)
    end
end

