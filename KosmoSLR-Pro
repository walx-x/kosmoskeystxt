function Fn.ApplyTheme(themeName)
    local t = Themes[themeName] or Themes["Obsidian Purple"]
    Settings.ThemeName = themeName
    Settings.Accent = t.Accent
    Settings.AccentBright = t.AccentBright
    Settings.BorderAccent = t.BorderAccent

    UI.WMStroke.Color = t.BorderAccent
    UI.PerfStroke.Color = t.BorderAccent
    UI.CombatHUDStroke.Color = t.BorderAccent
    UI.MoveHUDStroke.Color = t.BorderAccent
    UI.LeftCol.ScrollBarImageColor3 = t.Accent
    UI.RightCol.ScrollBarImageColor3 = t.Accent

    UI.HeaderTitle.Text = string.format('<font color="%s">KoSMO</font>  <font color="#847e98">Interface</font>  <font color="#504868">v2.5</font>', t.Hex)
    UI.FootRight.Text = string.format('Key: <font color="%s">%s</font>', t.Hex, State.KeyExpiration)
