function Fn.TriggerCustomAssetLoading(labelTitle)
    State.LoaderToken += 1
    local myToken = State.LoaderToken

    UI.LoaderStroke.Color = Settings.BorderAccent
    UI.LoaderTitle.TextColor3 = Settings.AccentBright
    UI.LoaderFill.BackgroundColor3 = Settings.Accent
    UI.LoaderTitle.Text = "KoSMO — " .. labelTitle
    UI.LoaderSub.Text = "Downloading & applying custom files..."
    UI.LoaderFill.Size = UDim2.fromScale(0, 1)
    UI.LoaderStatus.Text = "KoSMO Loading Bar: 0%"
    UI.AssetLoaderCard.Visible = true

    task.spawn(function()
        UI.LoaderLogo.Image = Fn.EnsureLogoLoaded()
        Fn.EnsureCustomAssetsLoaded()
    end)

    task.spawn(function()
        local totalDuration = 10.0
        local startTick = tick()
        local appliedMidway = false

        while tick() - startTick < totalDuration do
            if State.LoaderToken ~= myToken then return end
            local elapsed = tick() - startTick
            local pct = math.clamp(elapsed / totalDuration, 0, 1)
            local remaining = math.max(0, totalDuration - elapsed)

            UI.LoaderFill.Size = UDim2.fromScale(pct, 1)
            UI.LoaderStatus.Text = string.format("KoSMO Loading Bar: %d%%  (%.1fs)", math.floor(pct * 100), remaining)

            if pct >= 0.45 and not appliedMidway then
                appliedMidway = true
                UI.LoaderSub.Text = "Injecting skybox, skins & raw image links..."
                task.spawn(Fn.RefreshAllVisualAssets)
            end

            task.wait(0.05)
        end

        if State.LoaderToken ~= myToken then return end
        UI.LoaderFill.Size = UDim2.fromScale(1, 1)
        UI.LoaderStatus.Text = "KoSMO Loading Bar: 100% — Complete!"
        UI.LoaderSub.Text = "Custom assets applied successfully"
        task.spawn(Fn.RefreshAllVisualAssets)
        task.wait(0.9)
        if State.LoaderToken == myToken then
            UI.AssetLoaderCard.Visible = false
        end
    end)
end

function Fn.Notify(title, message, forceShow, isAlert)
