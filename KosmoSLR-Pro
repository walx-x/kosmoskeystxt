function Fn.GetAssetId(value)
    if not value then return nil end
    return tostring(value):match("%d+")
end

function Fn.NormalizeRobloxId(value)
    local digits = Fn.GetAssetId(value)
    if not digits or #digits < 4 then return nil end
    return "rbxassetid://" .. digits
end

function Fn.HashUrl(url)
    local h = 5381
    for i = 1, #url do
        h = ((h * 33) + string.byte(url, i)) % 2147483647
    end
    return tostring(h)
end

function Fn.LoadCustomTexture(url, fileName)
    if not url or url == "" or not writefile or not isfile or not getcustomasset then return nil end
    local ok, res = pcall(function()
        if not isfile(fileName) then
            writefile(fileName, game:HttpGet(url))
        end
        return getcustomasset(fileName)
    end)
    return ok and res or nil
end

function Fn.ResolveCustomAssetInput(rawValue)
    if not rawValue then return nil end
    local trimmed = tostring(rawValue):gsub("^%s+", ""):gsub("%s+$", "")
    if trimmed == "" then return nil end

    if trimmed:match("^https?://") then
        if State.UrlAssetCache[trimmed] then
            return State.UrlAssetCache[trimmed]
        end
        if not State.UrlDownloading[trimmed] then
            State.UrlDownloading[trimmed] = true
            task.spawn(function()
                local ext = trimmed:match("%.([%a%d]+)%??") or "webp"
                if #ext > 5 then ext = "webp" end
                local fileName = "KoSMO_RawSkin_" .. Fn.HashUrl(trimmed) .. "." .. ext
                local asset = Fn.LoadCustomTexture(trimmed, fileName)
                State.UrlDownloading[trimmed] = nil
                if asset then
                    State.UrlAssetCache[trimmed] = asset
                    Fn.RefreshAllVisualAssets()
                end
            end)
        end
        return nil
    end

    return Fn.NormalizeRobloxId(trimmed)
end

function Fn.EnsureLogoLoaded()
    if State.KosmoLogoAsset then return State.KosmoLogoAsset end
    State.KosmoLogoAsset = Fn.LoadCustomTexture(AssetsCfg.KOSMO_LOGO_URL, "KosmoLogo_9759.webp")
    return State.KosmoLogoAsset or AssetsCfg.KOSMO_LOGO_URL
end

function Fn.EnsureCustomAssetsLoaded()
    if State.AssetsDownloading then return end
    State.AssetsDownloading = true
    for assetId, url in pairs(AssetsCfg.ASSET_REPLACEMENTS) do
        if not State.CustomAssets[assetId] then
            local asset = Fn.LoadCustomTexture(url, "CustomAsset_" .. assetId .. ".webp")
            if asset then State.CustomAssets[assetId] = asset end
        end
        task.wait(0.05)
    end
    for assetId, file in pairs(AssetsCfg.SKYBOX_REPLACEMENTS) do
        if not State.SkyAssets[assetId] then
            local asset = Fn.LoadCustomTexture(AssetsCfg.SKYBOX_BASE_URL .. file, file)
            if asset then State.SkyAssets[assetId] = asset end
        end
        task.wait(0.05)
    end
    if not State.SparklesAsset then
        State.SparklesAsset = Fn.LoadCustomTexture(AssetsCfg.SPARKLES_TEXTURE_URL, "blue_sparks_1.webp")
    end
    for _, rawField in ipairs({
        Settings.CustomAR15RobloxID,
        Settings.CustomSMGRobloxID,
        Settings.CustomSparksRobloxID,
        Settings.CustomSkyboxRobloxID
    }) do
        if rawField and tostring(rawField):match("^%s*https?://") then
            Fn.ResolveCustomAssetInput(rawField)
        end
    end
    State.AssetsDownloading = false
end

