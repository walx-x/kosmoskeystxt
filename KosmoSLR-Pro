    end
end

function Fn.ApplyAllSettingsState()
    UI.WatermarkBar.Visible = Settings.ShowWatermark and not State.PanicActive
    UI.MainScale.Scale = Settings.UIScale / 100
    if not Settings.EnableWalkSpeed then Fn.RestoreWalkSpeedState() end
    Fn.ApplyTheme(Settings.ThemeName)
    Fn.ApplyUITransparency()
    Fn.ApplyOverlayPosition()
    Fn.UpdateCrosshairStyle()
    Fn.ApplyGhostMode(Settings.GhostMode)
    Fn.ApplyHighSaturation(Settings.HighSaturation)
    Fn.ApplyFullbright(Settings.Fullbright)
    Fn.ApplyFPSBoost(Settings.FPSBoost)
    Fn.ApplyNoDecals(Settings.NoDecals)
    Fn.ApplyToAllTools()
    Fn.RefreshAllReplacers()
    if Fn.SelectTab then Fn.SelectTab(State.ActiveTabName) end
end

function Fn.ResetAllSettings()
    for k, v in pairs(DefaultSettings) do
        Settings[k] = (type(v) == "table") and {} or v
    end
    State.CurrentRageTarget = nil
    State.CurrentAimbotTargetPlayer = nil
    State.CurrentSilentTargetPlayer = nil
    Fn.ApplyAllSettingsState()
    Fn.Notify("Settings", "All settings restored to defaults")
end

function Fn.LoadConfig(name)
    Fn.EnsureFolder()
    if not readfile or not isfile then return false end
    local filePath = AssetsCfg.CONFIG_FOLDER .. "/" .. name .. ".json"
    if not isfile(filePath) then return false end
    local ok, result = pcall(function() return HttpService:JSONDecode(readfile(filePath)) end)
    if ok and type(result) == "table" then
        for k, v in pairs(result) do
            if Settings[k] ~= nil then
                if type(v) == "table" and v.Type == "Color3" then
                    Settings[k] = Color3.new(v.R, v.G, v.B)
                elseif type(v) == "table" and v.Type == "Enum" then
                    local enumName = tostring(v.EnumType):gsub("^Enum%.", "")
                    pcall(function() Settings[k] = Enum[enumName][v.Name] end)
                else
                    Settings[k] = v
                end
            end
        end
        Settings.WalkSpeed = math.clamp(Settings.WalkSpeed, 6, 45)
        Settings.FlySpeed = math.clamp(Settings.FlySpeed, 1, 15)
        Fn.ApplyAllSettingsState()
        return true
    end
    return false
end

function Fn.UnloadScript()
    Settings.RageMode = false
    Settings.Noclip = false
    Settings.FlyEnabled = false
    Settings.EnableWalkSpeed = false
    State.CurrentRageTarget = nil
    State.CurrentAimbotTargetPlayer = nil
    State.CurrentSilentTargetPlayer = nil

    if State.SpectatingPlayer then
        local cam = Fn.GetCamera()
        local hum = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildWhichIsA("Humanoid")
        if cam and hum then cam.CameraSubject = hum end
    end

    for _, conn in ipairs(State.Connections) do
        if conn and conn.Connected then conn:Disconnect() end
    end
    table.clear(State.Connections)

    Fn.RestoreNoclipState()
    Fn.RestoreWalkSpeedState()
    Settings.GhostMode = false
    Fn.ApplyGhostMode(false)
    Fn.ApplyHighSaturation(false)
    Fn.ApplyFullbright(false)
    Fn.ApplyFPSBoost(false)
    Fn.ApplyNoDecals(false)

    Settings.WeaponAuto = false
    Settings.WeaponRapid = false
    Settings.WeaponNoRecoil = false
    Fn.ApplyToAllTools()

    Settings.CustomGunAudio = false
    Settings.CustomHeadshotAudio = false
    Settings.CustomSkitsAudio = false
    Settings.CustomAR15Skin = false
    Settings.CustomSMGSkin = false
    Settings.CustomSparksTexture = false
    Settings.CustomSkybox = false
    Fn.RefreshAllReplacers()

    if UI.ScreenGui then UI.ScreenGui:Destroy() end
end

if getgenv then
