function Fn.ApplyToTool(tool)
    if not tool or not tool:IsA("Tool") then return end

    local containers = {}
    for _, cname in ipairs({"Stats", "Configuration", "Settings", "GunStats"}) do
        local f = tool:FindFirstChild(cname)
        if f then table.insert(containers, f) end
    end
    table.insert(containers, tool)

    local defs = {
        {flag = Settings.WeaponAuto, names = {"GunType", "FireMode", "Mode"}, val = "Auto", boolNames = {"Auto", "Automatic", "FullAuto"}, boolVal = true},
        {flag = Settings.WeaponRapid, names = {"FireRate", "Cooldown", "Delay", "ShootDelay"}, val = Settings.RapidFireRate},
        {flag = Settings.WeaponNoRecoil, names = {"Recoil", "CameraRecoil", "Kick", "Spread"}, val = 0}
    }

    for _, d in ipairs(defs) do
        for _, container in ipairs(containers) do
            for _, sName in ipairs(d.names) do
                local stat = container:FindFirstChild(sName)
                if stat and stat:IsA("ValueBase") then
                    local key = tool.Name .. "::" .. container.Name .. "::" .. sName
                    if d.flag then
                        if State.OriginalWeaponStatsByKey[key] == nil then
                            State.OriginalWeaponStatsByKey[key] = stat.Value
                        end
                        if State.OriginalWeaponStatsByInstance[stat] == nil then
                            State.OriginalWeaponStatsByInstance[stat] = State.OriginalWeaponStatsByKey[key]
                        end
                        pcall(function() stat.Value = d.val end)
                    else
                        local orig = State.OriginalWeaponStatsByInstance[stat]
                        if orig == nil then orig = State.OriginalWeaponStatsByKey[key] end
                        if orig ~= nil then
                            pcall(function() stat.Value = orig end)
                            State.OriginalWeaponStatsByInstance[stat] = nil
                        end
                    end
                end
            end

            if d.boolNames then
                for _, bName in ipairs(d.boolNames) do
                    local bStat = container:FindFirstChild(bName)
                    if bStat and bStat:IsA("BoolValue") then
                        local bKey = tool.Name .. "::" .. container.Name .. "::" .. bName
                        if d.flag then
                            if State.OriginalWeaponStatsByKey[bKey] == nil then
                                State.OriginalWeaponStatsByKey[bKey] = bStat.Value
                            end
                            if State.OriginalWeaponStatsByInstance[bStat] == nil then
                                State.OriginalWeaponStatsByInstance[bStat] = State.OriginalWeaponStatsByKey[bKey]
                            end
                            bStat.Value = d.boolVal
                        else
                            local orig = State.OriginalWeaponStatsByInstance[bStat]
                            if orig == nil then orig = State.OriginalWeaponStatsByKey[bKey] end
                            if orig ~= nil then
                                bStat.Value = orig
                                State.OriginalWeaponStatsByInstance[bStat] = nil
                            end
                        end
                    end
                end
            end
        end

        for _, attrName in ipairs(d.names) do
            local curAttr = tool:GetAttribute(attrName)
            if curAttr ~= nil then
                local aKey = tool.Name .. "::ATTR::" .. attrName
                if d.flag then
                    if State.OriginalWeaponAttrsByKey[aKey] == nil then
                        State.OriginalWeaponAttrsByKey[aKey] = curAttr
                    end
                    pcall(function() tool:SetAttribute(attrName, d.val) end)
                elseif State.OriginalWeaponAttrsByKey[aKey] ~= nil then
                    pcall(function() tool:SetAttribute(attrName, State.OriginalWeaponAttrsByKey[aKey]) end)
                end
            end
        end
    end
end

