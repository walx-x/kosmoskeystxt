        vLbl.Position = UDim2.new(1, -32, 0, yPos); vLbl.Size = UDim2.fromOffset(24, 14)

        local track = Fn.Create("TextButton", { Size = UDim2.new(1, -60, 0, 5), Position = UDim2.fromOffset(24, yPos + 5), BackgroundColor3 = Settings.BgMain, BorderSizePixel = 0, Text = "", AutoButtonColor = false }, drawer)
        Fn.Corner(track, 999)

        local fill = Fn.Create("Frame", { Size = UDim2.new(getVal() / 255, 0, 1, 0), BackgroundColor3 = barCol, BorderSizePixel = 0 }, track)
        Fn.Corner(fill, 999)

        table.insert(rgbUpdaters, function()
            local v = getVal()
            fill.Size = UDim2.new(v / 255, 0, 1, 0)
            vLbl.Text = tostring(v)
        end)

        local drag = false
        local function upd(input)
            local pos = math.clamp((input.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
            setVal(math.floor(pos * 255 + 0.5))
            commitColor(Color3.fromRGB(curR, curG, curB))
        end

        track.InputBegan:Connect(function(inp) if inp.UserInputType == Enum.UserInputType.MouseButton1 then drag = true; upd(inp) end end)
        UserInputService.InputEnded:Connect(function(inp) if inp.UserInputType == Enum.UserInputType.MouseButton1 then drag = false end end)
        UserInputService.InputChanged:Connect(function(inp) if drag and inp.UserInputType == Enum.UserInputType.MouseMovement then upd(inp) end end)
    end

    makeChannelBar("R", 28, Color3.fromRGB(235, 75, 95), function() return curR end, function(v) curR = v end)
    makeChannelBar("G", 52, Color3.fromRGB(78, 218, 140), function() return curG end, function(v) curG = v end)
    makeChannelBar("B", 76, Color3.fromRGB(70, 165, 255), function() return curB end, function(v) curB = v end)

    local open = false
    swatchBtn.MouseButton1Click:Connect(function()
        Fn.PlayUISound()
        open = not open
        drawer.Visible = open
        holder.Size = UDim2.new(1, 0, 0, open and 134 or 20)
    end)
    return holder
end

