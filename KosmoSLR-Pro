function Fn.SetMenuVisible(state)
    local targetScale = Settings.UIScale / 100
    if state then
        UI.Main.Visible = true
        if Settings.MenuAnimations then
            UI.MainScale.Scale = targetScale * 0.95
            Fn.Tween(UI.MainScale, UI.SmoothTween, { Scale = targetScale })
        else
            UI.MainScale.Scale = targetScale
        end
    else
        if Settings.MenuAnimations then
            Fn.Tween(UI.MainScale, UI.FastTween, { Scale = targetScale * 0.95 })
            task.delay(0.14, function()
                if UI.MainScale.Scale <= (targetScale * 0.96) then UI.Main.Visible = false end
            end)
        else
            UI.Main.Visible = false
        end
    end
end

function Fn.TogglePanicMode()
