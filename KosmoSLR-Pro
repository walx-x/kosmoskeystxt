function Fn.AddSlider(parent, name, min, max, defaultVal, suffix, callback)
    local holder = Fn.Create("Frame", { Size = UDim2.new(1, 0, 0, 26), BackgroundTransparency = 1 }, parent)
    local lbl = Fn.Label(holder, name, 10, Settings.SubText, Enum.Font.GothamMedium)
    lbl.Size = UDim2.new(0.65, 0, 0, 14)

    local clampedInit = math.clamp(defaultVal, min, max)
    local valLbl = Fn.Label(holder, tostring(clampedInit) .. suffix, 10, Settings.Text, Enum.Font.GothamBold, Enum.TextXAlignment.Right)
    valLbl.Position = UDim2.new(0.65, 0, 0, 0)
    valLbl.Size = UDim2.new(0.35, 0, 0, 14)

    local track = Fn.Create("TextButton", { Size = UDim2.new(1, 0, 0, 4), Position = UDim2.fromOffset(0, 18), BackgroundColor3 = Settings.BgControl, BorderSizePixel = 0, Text = "", AutoButtonColor = false }, holder)
    Fn.Corner(track, 999)
    Fn.Stroke(track, Settings.Border, 0.5)

    local pct = math.clamp((clampedInit - min) / math.max(1, max - min), 0, 1)
    local fill = Fn.Create("Frame", { Size = UDim2.new(pct, 0, 1, 0), BackgroundColor3 = Settings.Accent, BorderSizePixel = 0 }, track)
    Fn.Corner(fill, 999)

    local dragging = false
    local function update(input)
        local pos = math.clamp((input.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
        local val = math.floor(min + (max - min) * pos + 0.5)
        fill.Size = UDim2.new(pos, 0, 1, 0)
        valLbl.Text = tostring(val) .. suffix
        if callback then callback(val) end
    end

    track.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then dragging = true; update(input) end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then update(input) end
    end)
    return holder
end

