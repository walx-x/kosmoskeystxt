function Fn.RenderPlayers()
    Fn.ClearColumns()
    local allPlrs = Players:GetPlayers()
    if not State.SelectedPlayerObj or not State.SelectedPlayerObj.Parent then
        for _, p in ipairs(allPlrs) do
            if p ~= LocalPlayer then State.SelectedPlayerObj = p; break end
        end
        if not State.SelectedPlayerObj then State.SelectedPlayerObj = LocalPlayer end
    end

    local listCard = Fn.CreateGroupCard(UI.LeftCol, string.format("Server Players (%d / %d)", #allPlrs, Players.MaxPlayers))
    local listHolder = Fn.Create("ScrollingFrame", { Size = UDim2.new(1, 0, 0, 220), BackgroundColor3 = Settings.BgControl, BorderSizePixel = 0, CanvasSize = UDim2.new(0, 0, 0, 0), ScrollBarThickness = 2, ScrollBarImageColor3 = Settings.Accent, LayoutOrder = 2 }, listCard)
    Fn.Corner(listHolder, 4)
    Fn.Stroke(listHolder, Settings.Border, 0.3)

    local lLayout = Fn.Create("UIListLayout", { Padding = UDim.new(0, 2), SortOrder = Enum.SortOrder.LayoutOrder }, listHolder)
    Fn.Create("UIPadding", { PaddingTop = UDim.new(0, 4), PaddingBottom = UDim.new(0, 4), PaddingLeft = UDim.new(0, 4), PaddingRight = UDim.new(0, 4) }, listHolder)
    lLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        listHolder.CanvasSize = UDim2.new(0, 0, 0, lLayout.AbsoluteContentSize.Y + 8)
    end)

    local function rebuildPlayerRows()
        for _, c in ipairs(listHolder:GetChildren()) do if c:IsA("TextButton") then c:Destroy() end end
        local q = State.PlayerSearchQuery:lower()
        for _, plr in ipairs(Players:GetPlayers()) do
            if q == "" or plr.Name:lower():find(q, 1, true) or plr.DisplayName:lower():find(q, 1, true) then
                local isSel = (State.SelectedPlayerObj == plr)
                local isStaff = State.DetectedAdmins[plr] ~= nil
                local rowBtn = Fn.Create("TextButton", { Size = UDim2.new(1, 0, 0, 24), BackgroundColor3 = isStaff and Color3.fromRGB(58, 20, 30) or (isSel and Settings.Accent or Settings.BgCard), BackgroundTransparency = isStaff and 0.35 or (isSel and 0.65 or 0.2), BorderSizePixel = 0, Text = "", AutoButtonColor = false }, listHolder)
                Fn.Corner(rowBtn, 4)

