function Fn.ProcessSound(obj)
    if not obj or not obj:IsA("Sound") or not obj.Parent then return end
    if State.ReapplyingSound[obj] then return end

    if not State.HookedSounds[obj] then
        State.HookedSounds[obj] = true
        obj:GetPropertyChangedSignal("SoundId"):Connect(function()
            if not State.ReapplyingSound[obj] then Fn.ProcessSound(obj) end
        end)
    end

    local origFull = State.OriginalSoundIds[obj] or obj.SoundId
    local origId = Fn.GetAssetId(origFull)
    if not origId then return end

    if origId == AssetsCfg.SKITS_OLD_ID then
        local customSkits = Fn.NormalizeRobloxId(Settings.CustomSkitsSoundID) or AssetsCfg.SKITS_NEW_ID
        if Settings.CustomSkitsAudio then
            if not State.OriginalSoundIds[obj] then State.OriginalSoundIds[obj] = obj.SoundId end
            if obj.SoundId ~= customSkits then
                State.ReapplyingSound[obj] = true
                pcall(function() obj.SoundId = customSkits end)
                State.ReapplyingSound[obj] = nil
            end
        elseif State.OriginalSoundIds[obj] then
            State.ReapplyingSound[obj] = true
            pcall(function() obj.SoundId = State.OriginalSoundIds[obj] end)
            State.ReapplyingSound[obj] = nil
            State.OriginalSoundIds[obj] = nil
        end
        return
    end

    local rep = nil
    if AssetsCfg.ORIGINAL_SOUNDS[origId] then
        rep = Fn.NormalizeRobloxId(Settings.CustomGunSoundID) or AssetsCfg.CUSTOM_GUN_SOUND
    elseif AssetsCfg.ORIGINAL_GLASS_IMPACTS[origId] then
        rep = AssetsCfg.CUSTOM_GLASS_IMPACT
    elseif AssetsCfg.ORIGINAL_NORMAL_IMPACTS[origId] then
        rep = AssetsCfg.CUSTOM_NORMAL_IMPACT
    end

    if rep then
        if Settings.CustomGunAudio then
            if not State.OriginalSoundIds[obj] then State.OriginalSoundIds[obj] = obj.SoundId end
            if obj.SoundId ~= rep then
                State.ReapplyingSound[obj] = true
                pcall(function() obj.SoundId = rep end)
                State.ReapplyingSound[obj] = nil
            end
        elseif State.OriginalSoundIds[obj] then
            State.ReapplyingSound[obj] = true
            pcall(function() obj.SoundId = State.OriginalSoundIds[obj] end)
            State.ReapplyingSound[obj] = nil
            State.OriginalSoundIds[obj] = nil
        end
    end
end

