        local curKey = bindKeyGetter()
        local keyBtn = Fn.Create("TextButton", { Size = UDim2.fromOffset(52, 16), Position = UDim2.new(1, -52, 0.5, -8), BackgroundColor3 = Settings.BgControl, BorderSizePixel = 0, Text = curKey and curKey.Name or "None", TextColor3 = Settings.SubText, TextSize = 8, Font = Enum.Font.GothamBold, AutoButtonColor = false }, row)
