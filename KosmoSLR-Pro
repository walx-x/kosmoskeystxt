function Fn.ExecuteClickTP()
    local cam = Fn.GetCamera()
    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not cam or not root then return end

    local mp = Fn.GetMousePosition()
    local ray = cam:ViewportPointToRay(mp.X, mp.Y)
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = {char}

    local result = workspace:Raycast(ray.Origin, ray.Direction * 2500, params)
    if result and result.Position then
        root.CFrame = CFrame.new(result.Position + Vector3.new(0, 3.2, 0)) * (root.CFrame - root.CFrame.Position)
        root.AssemblyLinearVelocity = Vector3.zero
    end
end

function Fn.IsIgnored(player)
    if player == LocalPlayer then return true end
    if Settings.WhitelistCombatCheck and Settings.Whitelist[player.Name] then return true end
    return false
end

function Fn.IsTargetVisible(part, wallCheckEnabled)
    if not wallCheckEnabled then return true end
    local cam = Fn.GetCamera()
    if not cam then return false end
    return #cam:GetPartsObscuringTarget({part.Position}, {LocalPlayer.Character, part.Parent}) == 0
end

function Fn.GetCurrentFOV()
    if not Settings.DynamicFOV then return Settings.BaseFOV end
    local cam = Fn.GetCamera()
    if not cam then return Settings.BaseFOV end
    local camPos = cam.CFrame.Position
    local closestDist = math.huge
    for _, player in ipairs(Players:GetPlayers()) do
        if not Fn.IsIgnored(player) and player.Character then
            local root = player.Character:FindFirstChild("HumanoidRootPart")
            if root then
                local dist = (root.Position - camPos).Magnitude
                if dist < closestDist then closestDist = dist end
            end
        end
    end
    if closestDist ~= math.huge and closestDist > 0 then
        return math.clamp(Settings.BaseFOV * (50 / closestDist), 12, 1500)
    end
    return Settings.BaseFOV
end

function Fn.FindClosestTarget(maxDistance, customPart, wallCheck)
    local cam = Fn.GetCamera()
    if not cam then return nil, nil, nil end
    local mousePos = Fn.GetMousePosition()
    local bestDist, bestPart, bestScreenPos, bestPlayer = maxDistance, nil, nil, nil

    for _, player in ipairs(Players:GetPlayers()) do
        if not Fn.IsIgnored(player) and player.Character then
            local char = player.Character
            local humanoid = char:FindFirstChildWhichIsA("Humanoid")
            if humanoid and humanoid.Health > 0 then
                if customPart then
                    for _, obj in ipairs(char:GetChildren()) do
                        if obj:IsA("BasePart") then
                            local screenPos, onScreen = cam:WorldToViewportPoint(obj.Position)
                            if onScreen and screenPos.Z > 0 then
                                local vec = Vector2.new(screenPos.X, screenPos.Y)
                                local dist = (vec - mousePos).Magnitude
                                if dist <= bestDist and Fn.IsTargetVisible(obj, wallCheck) then
                                    bestDist, bestPart, bestScreenPos, bestPlayer = dist, obj, vec, player
                                end
                            end
                        end
                    end
                else
                    local part = char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart")
                    if part then
                        local screenPos, onScreen = cam:WorldToViewportPoint(part.Position)
                        if onScreen and screenPos.Z > 0 then
                            local vec = Vector2.new(screenPos.X, screenPos.Y)
                            local dist = (vec - mousePos).Magnitude
                            if dist <= bestDist and Fn.IsTargetVisible(part, wallCheck) then
                                bestDist, bestPart, bestScreenPos, bestPlayer = dist, part, vec, player
                            end
                        end
                    end
                end
            end
        end
    end
    return bestPart, bestScreenPos, bestPlayer
end

function Fn.RunAimbot(targetPart, targetVector2)
    if not targetPart then return end
    if Settings.AimbotMode == "Memory" then
        local cam = Fn.GetCamera()
        if cam then
            local goalCFrame = CFrame.new(cam.CFrame.Position, targetPart.Position)
            cam.CFrame = cam.CFrame:Lerp(goalCFrame, math.clamp(Settings.AimbotSmoothness, 0.01, 1))
        end
    else
        local mousePos = Fn.GetMousePosition()
        local deltaX = (targetVector2.X - mousePos.X) * Settings.AimbotSmoothness
        local deltaY = (targetVector2.Y - mousePos.Y) * Settings.AimbotSmoothness
        if typeof(mousemoverel) == "function" then
            mousemoverel(deltaX, deltaY)
        else
            local cam = Fn.GetCamera()
            if cam then
                local goalCFrame = CFrame.new(cam.CFrame.Position, targetPart.Position)
                cam.CFrame = cam.CFrame:Lerp(goalCFrame, math.clamp(Settings.AimbotSmoothness, 0.01, 1))
            end
        end
    end
end

function Fn.IsValidRageTarget(player)
    if not player or not player.Parent or Fn.IsIgnored(player) then return false end
    local char = player.Character
    if not char then return false end
    local hum = char:FindFirstChildWhichIsA("Humanoid")
    local root = char:FindFirstChild("HumanoidRootPart")
    return hum and root and hum.Health > 0
end

function Fn.GetRageTarget()
    if Settings.RageTargetMode == "Aimbot Locked" then
        if Fn.IsValidRageTarget(State.CurrentAimbotTargetPlayer) then
            State.CurrentRageTarget = State.CurrentAimbotTargetPlayer
            return State.CurrentAimbotTargetPlayer
        end
        if Fn.IsValidRageTarget(State.CurrentRageTarget) then
            State.CurrentAimbotTargetPlayer = State.CurrentRageTarget
            return State.CurrentRageTarget
        end
    elseif Fn.IsValidRageTarget(State.CurrentRageTarget) then
        return State.CurrentRageTarget
    end
    State.CurrentRageTarget = nil

    local localChar = LocalPlayer.Character
    local localRoot = localChar and localChar:FindFirstChild("HumanoidRootPart")
    local cam = Fn.GetCamera()
    local mousePos = Fn.GetMousePosition()
    local bestPlayer, bestMetric = nil, math.huge

    for _, player in ipairs(Players:GetPlayers()) do
        if Fn.IsValidRageTarget(player) then
            local targetRoot = player.Character:FindFirstChild("HumanoidRootPart")
            if (Settings.RageTargetMode == "Closest Cursor" or Settings.RageTargetMode == "Aimbot Locked") and cam then
                local screenPos, onScreen = cam:WorldToViewportPoint(targetRoot.Position)
                if onScreen and screenPos.Z > 0 then
                    local dist = (Vector2.new(screenPos.X, screenPos.Y) - mousePos).Magnitude
                    if dist < bestMetric then bestMetric, bestPlayer = dist, player end
                elseif localRoot then
                    local dist = (targetRoot.Position - localRoot.Position).Magnitude + 5000
                    if dist < bestMetric then bestMetric, bestPlayer = dist, player end
                end
            elseif localRoot then
                local dist = (targetRoot.Position - localRoot.Position).Magnitude
                if dist < bestMetric then bestMetric, bestPlayer = dist, player end
            end
        end
    end

    State.CurrentRageTarget = bestPlayer
    if Settings.RageTargetMode == "Aimbot Locked" and bestPlayer then
        State.CurrentAimbotTargetPlayer = bestPlayer
    end
    return bestPlayer
end

function Fn.UpdateRageMode()
    if not Settings.RageMode then
        State.CurrentRageTarget = nil
        return
    end
    local localChar = LocalPlayer.Character
    local localRoot = localChar and localChar:FindFirstChild("HumanoidRootPart")
    if not localRoot then return end

    local targetPlayer = Fn.GetRageTarget()
    if not targetPlayer or not targetPlayer.Character then return end
    local targetRoot = targetPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not targetRoot then return end

    local abovePos = targetRoot.Position + Vector3.new(0, Settings.RageHeight, 0)
    local lookVec = targetRoot.CFrame.LookVector
    local flatLook = Vector3.new(lookVec.X, 0, lookVec.Z)

    if flatLook.Magnitude > 0.01 then
        localRoot.CFrame = CFrame.lookAt(abovePos, abovePos + flatLook.Unit)
    else
        localRoot.CFrame = CFrame.new(abovePos)
    end
    localRoot.AssemblyLinearVelocity = Vector3.zero
    localRoot.AssemblyAngularVelocity = Vector3.zero
end

