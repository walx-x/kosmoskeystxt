    end

    local presetRow = Fn.Create("Frame", { Size = UDim2.new(1, -12, 0, 16), Position = UDim2.fromOffset(6, 6), BackgroundTransparency = 1 }, drawer)
    Fn.Create("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 5), SortOrder = Enum.SortOrder.LayoutOrder }, presetRow)

    for _, pCol in ipairs(AssetsCfg.SWATCH_PALETTE) do
        local pBtn = Fn.Create("TextButton", { Size = UDim2.fromOffset(22, 14), BackgroundColor3 = pCol, BorderSizePixel = 0, Text = "", AutoButtonColor = false }, presetRow)
        Fn.Corner(pBtn, 3)
        pBtn.MouseButton1Click:Connect(function() Fn.PlayUISound(); commitColor(pCol) end)
    end

    local function makeChannelBar(channelName, yPos, barCol, getVal, setVal)
        local cLbl = Fn.Label(drawer, channelName, 9, Settings.SubText, Enum.Font.GothamBold)
        cLbl.Position = UDim2.fromOffset(8, yPos); cLbl.Size = UDim2.fromOffset(14, 14)

