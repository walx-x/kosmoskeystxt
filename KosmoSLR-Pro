    local listFrame = Fn.Create("ScrollingFrame", { Size = UDim2.new(1, 0, 0, 95), Position = UDim2.fromOffset(0, 40), BackgroundColor3 = Settings.BgMain, BorderSizePixel = 0, Visible = false, ZIndex = 60, CanvasSize = UDim2.new(0, 0, 0, 0), ScrollBarThickness = 2, ScrollBarImageColor3 = Settings.Accent }, holder)
    Fn.Corner(listFrame, 4)
    Fn.Stroke(listFrame, Settings.BorderAccent, 0.3)

    local listLayout = Fn.Create("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder }, listFrame)
    listLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        listFrame.CanvasSize = UDim2.new(0, 0, 0, listLayout.AbsoluteContentSize.Y)
    end)

    local open = false
    local function populate()
        for _, c in ipairs(listFrame:GetChildren()) do if c:IsA("TextButton") then c:Destroy() end end
        for _, item in ipairs(optionsGetter()) do
            local opt = Fn.Create("TextButton", { Size = UDim2.new(1, 0, 0, 22), BackgroundTransparency = 1, Text = "  " .. item.label, TextColor3 = item.active and Settings.Green or Settings.Text, TextSize = 10, Font = Enum.Font.GothamMedium, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 61 }, listFrame)
            opt.MouseButton1Click:Connect(function()
                Fn.PlayUISound()
                local newDisplay, closeMenu = onSelect(item.value)
                if newDisplay then selectedLbl.Text = newDisplay end
                if closeMenu then
                    open = false
                    listFrame.Visible = false
                    holder.Size = UDim2.new(1, 0, 0, 38)
                else
                    populate()
                end
            end)
        end
    end

    btn.MouseButton1Click:Connect(function()
        Fn.PlayUISound()
        open = not open
        if open then
            populate()
            listFrame.Visible = true
            holder.Size = UDim2.new(1, 0, 0, 138)
        else
            listFrame.Visible = false
            holder.Size = UDim2.new(1, 0, 0, 38)
        end
    end)
    return holder, selectedLbl
end

