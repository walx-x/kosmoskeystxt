    if not Settings.ShowNotifications and not forceShow then return end

    local borderCol = isAlert and Settings.Red or Settings.BorderAccent
    local titleCol = isAlert and Settings.Red or Settings.AccentBright
    local lineCol = isAlert and Settings.Red or Settings.Accent

