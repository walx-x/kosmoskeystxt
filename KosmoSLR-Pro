    local curG = math.floor(initialColor.G * 255 + 0.5)
    local curB = math.floor(initialColor.B * 255 + 0.5)

    local rgbUpdaters = {}
    local function commitColor(c)
        curR = math.floor(c.R * 255 + 0.5)
        curG = math.floor(c.G * 255 + 0.5)
        curB = math.floor(c.B * 255 + 0.5)
