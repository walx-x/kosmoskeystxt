function Fn.ResolveSkinOrSparkReplacement(id)
    if not id then return nil end
    if id == AssetsCfg.AR15_OLD_ID then
        if not Settings.CustomAR15Skin then return nil end
        return Fn.ResolveCustomAssetInput(Settings.CustomAR15RobloxID) or State.CustomAssets[id]
    elseif id == AssetsCfg.SMG_OLD_ID then
        if not Settings.CustomSMGSkin then return nil end
        return Fn.ResolveCustomAssetInput(Settings.CustomSMGRobloxID) or State.CustomAssets[id]
    elseif id == AssetsCfg.SPARKLES_OLD_ID then
        if not Settings.CustomSparksTexture then return nil end
        return Fn.ResolveCustomAssetInput(Settings.CustomSparksRobloxID) or State.SparklesAsset
    end
    return nil
end

function Fn.ProcessAssetObject(obj)
    if not obj or not obj.Parent then return end
    local assetProps = {"Texture", "TextureID", "Image", "ColorMap"}
    local skyProps = {"SkyboxBk", "SkyboxFt", "SkyboxRt", "SkyboxLf", "SkyboxDn", "SkyboxUp"}

    for _, prop in ipairs(assetProps) do
        local ok, val = pcall(function() return obj[prop] end)
        if ok and typeof(val) == "string" then
            local origVal = (State.OriginalAssetValues[obj] and State.OriginalAssetValues[obj][prop]) or val
            local id = Fn.GetAssetId(origVal)
            local rep = Fn.ResolveSkinOrSparkReplacement(id)
            if rep then
                if val ~= rep then
                    if not State.OriginalAssetValues[obj] then State.OriginalAssetValues[obj] = {} end
                    if not State.OriginalAssetValues[obj][prop] then State.OriginalAssetValues[obj][prop] = val end
                    pcall(function() obj[prop] = rep end)
                end
            elseif State.OriginalAssetValues[obj] and State.OriginalAssetValues[obj][prop] then
                pcall(function() obj[prop] = State.OriginalAssetValues[obj][prop] end)
                State.OriginalAssetValues[obj][prop] = nil
            end
        end
    end

    if obj:IsA("Sky") then
        local customSkyOverride = Fn.ResolveCustomAssetInput(Settings.CustomSkyboxRobloxID)
        if Settings.CustomSkybox then
            for _, prop in ipairs(skyProps) do
                local ok, val = pcall(function() return obj[prop] end)
                if ok and typeof(val) == "string" then
                    local origVal = (State.OriginalAssetValues[obj] and State.OriginalAssetValues[obj][prop]) or val
                    local id = Fn.GetAssetId(origVal)
                    local rep = customSkyOverride or (id and State.SkyAssets[id])
                    if rep and val ~= rep then
                        if not State.OriginalAssetValues[obj] then State.OriginalAssetValues[obj] = {} end
                        if not State.OriginalAssetValues[obj][prop] then State.OriginalAssetValues[obj][prop] = val end
                        pcall(function() obj[prop] = rep end)
                    end
                end
            end
        elseif State.OriginalAssetValues[obj] then
            for _, prop in ipairs(skyProps) do
                if State.OriginalAssetValues[obj][prop] then
                    pcall(function() obj[prop] = State.OriginalAssetValues[obj][prop] end)
                    State.OriginalAssetValues[obj][prop] = nil
                end
            end
        end
    end

    if not State.HookedAssets[obj] then
        State.HookedAssets[obj] = true
        for _, prop in ipairs(assetProps) do
            pcall(function()
                obj:GetPropertyChangedSignal(prop):Connect(function()
                    if Settings.CustomAR15Skin or Settings.CustomSMGSkin or Settings.CustomSparksTexture then
                        Fn.ProcessAssetObject(obj)
                    end
                end)
            end)
        end
        if obj:IsA("Sky") then
            for _, prop in ipairs(skyProps) do
                pcall(function()
                    obj:GetPropertyChangedSignal(prop):Connect(function()
                        if Settings.CustomSkybox then Fn.ProcessAssetObject(obj) end
                    end)
                end)
            end
        end
    end
end

