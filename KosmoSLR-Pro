function Fn.FetchKeyInformation()
    local keyFilePath = "KosmosKey.txt"
    if readfile and isfile and isfile(keyFilePath) then
        local content = readfile(keyFilePath)
        if content then State.ActiveKey = string.gsub(content, "%s+", "") end
    end

    if State.ActiveKey ~= "" and State.ActiveKey ~= "Not Found" then
        local success, response = pcall(function()
            return game:HttpGet("https://raw.githubusercontent.com/walx-x/kosmoskeystxt/refs/heads/main/KosmosPaidKeys.json")
        end)
        if success and response then
            local ok, keysData = pcall(function() return HttpService:JSONDecode(response) end)
            if ok and keysData and keysData[State.ActiveKey] then
                local info = keysData[State.ActiveKey]
                State.KeyExpiration = (info.duration == "lt" or info.expires_at == nil or info.expires_at == "null")
                    and "Lifetime" or tostring(info.expires_at)
            else
                State.KeyExpiration = "Invalid Key"
            end
        else
            State.KeyExpiration = "Offline"
        end
    else
        State.KeyExpiration = "No Key"
    end
end

function Fn.EnsureFolder()
    if makefolder and isfolder and not isfolder(AssetsCfg.CONFIG_FOLDER) then
        makefolder(AssetsCfg.CONFIG_FOLDER)
    end
end

function Fn.LoadSavedSounds()
    table.clear(State.SavedSounds)
    for _, item in ipairs(AssetsCfg.DEFAULT_SOUNDS) do
        table.insert(State.SavedSounds, { Name = item.Name, Id = item.Id })
    end
    Fn.EnsureFolder()
    if readfile and isfile and isfile(AssetsCfg.SOUNDS_FILE) then
        local ok, data = pcall(function() return HttpService:JSONDecode(readfile(AssetsCfg.SOUNDS_FILE)) end)
        if ok and type(data) == "table" then
            for _, entry in ipairs(data) do
                if type(entry) == "table" and entry.Name and entry.Id then
                    local exists = false
                    for _, cur in ipairs(State.SavedSounds) do
                        if cur.Id == entry.Id and cur.Name == entry.Name then exists = true; break end
                    end
                    if not exists then
                        table.insert(State.SavedSounds, { Name = tostring(entry.Name), Id = tostring(entry.Id) })
                    end
                end
            end
        end
    end
end

function Fn.SaveSoundsToFile()
    Fn.EnsureFolder()
    if writefile then
        pcall(function()
            writefile(AssetsCfg.SOUNDS_FILE, HttpService:JSONEncode(State.SavedSounds))
        end)
    end
end

function Fn.GetSavedConfigs()
    Fn.EnsureFolder()
    local configs = {}
    if listfiles then
        local ok, files = pcall(function() return listfiles(AssetsCfg.CONFIG_FOLDER) end)
        if ok and files then
            for _, filePath in ipairs(files) do
                if filePath:sub(-5) == ".json" then
                    local fileName = filePath:match("([^/^\\]+)%.json$")
                    if fileName and fileName ~= "saved_sounds" then table.insert(configs, fileName) end
                end
            end
        end
    end
    return configs
end

function Fn.SaveConfig(name)
    Fn.EnsureFolder()
    if not writefile or name == "" then return false end
    local data = {}
    for k, v in pairs(Settings) do
        if typeof(v) == "Color3" then
            data[k] = {R = v.R, G = v.G, B = v.B, Type = "Color3"}
        elseif typeof(v) == "EnumItem" then
            data[k] = {Name = v.Name, EnumType = tostring(v.EnumType), Type = "Enum"}
        elseif type(v) ~= "table" then
            data[k] = v
        end
    end
    return pcall(function()
