function Fn.RenderSkeletonESP(cam, char, entry, boneColor)
    if not Settings.ESPSkeleton then
        for i = 1, 14 do entry.Bones[i].Visible = false end
        return
    end

    local boneList = char:FindFirstChild("UpperTorso") and AssetsCfg.R15_BONES or AssetsCfg.R6_BONES
    for i = 1, 14 do
        local pair = boneList[i]
        local line = entry.Bones[i]
        if pair then
            local p1 = char:FindFirstChild(pair[1])
            local p2 = char:FindFirstChild(pair[2])
            if p1 and p2 and p1:IsA("BasePart") and p2:IsA("BasePart") then
                local s1, on1 = cam:WorldToViewportPoint(p1.Position)
                local s2, on2 = cam:WorldToViewportPoint(p2.Position)
                if s1.Z > 0 and s2.Z > 0 and (on1 or on2) then
                    local dx, dy = s2.X - s1.X, s2.Y - s1.Y
                    line.Size = UDim2.fromOffset(math.sqrt(dx * dx + dy * dy), 1.4)
                    line.Position = UDim2.fromOffset((s1.X + s2.X) * 0.5, (s1.Y + s2.Y) * 0.5)
                    line.Rotation = math.deg(math.atan2(dy, dx))
                    line.BackgroundColor3 = boneColor
                    line.Visible = true
                else
                    line.Visible = false
                end
            else
                line.Visible = false
            end
        else
            line.Visible = false
        end
    end
end

function Fn.UpdateESP()
    if State.PanicActive or not Settings.ESPEnabled then
        for _, entry in pairs(State.ESPCache) do Fn.HideESP(entry) end
        return
    end

    local cam = Fn.GetCamera()
    if not cam then return end
    local viewportSize = cam.ViewportSize
    local camPos = cam.CFrame.Position
    local mousePos = Fn.GetMousePosition()

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local char = player.Character
            local root = char and char:FindFirstChild("HumanoidRootPart")
            local humanoid = char and char:FindFirstChildWhichIsA("Humanoid")
            local sameTeam = Settings.ESPTeamCheck and LocalPlayer.Team ~= nil and player.Team == LocalPlayer.Team
            local isWL = Settings.Whitelist[player.Name] == true
            local hideWL = Settings.ESPWhitelistCheck and isWL

            if root and humanoid and humanoid.Health > 0 and not sameTeam and not hideWL then
                local studDist = (root.Position - camPos).Magnitude
                if studDist <= Settings.ESPMaxDistance then
                    local entry = Fn.GetOrCreateESP(player)
                    local isStaff = State.DetectedAdmins[player] ~= nil
                    local isLocked = (State.CurrentAimbotTargetPlayer == player) or (State.CurrentSilentTargetPlayer == player)
                    local primaryCol = isStaff and Settings.Red or (isLocked and Settings.AccentBright or (isWL and Settings.Green or Settings.ESPColor))

                    if Settings.ESPChams then
                        entry.Highlight.Adornee = char
                        entry.Highlight.FillColor = isStaff and Settings.Red or Settings.ChamColor
                        entry.Highlight.OutlineColor = Settings.ChamOutlineColor
                        entry.Highlight.Enabled = true
                    else
                        entry.Highlight.Enabled = false
                    end

                    Fn.RenderSkeletonESP(cam, char, entry, isStaff and Settings.Red or Settings.ESPSkeletonColor)

                    local head = char:FindFirstChild("Head") or root
                    local headCenter, headOnScreen = cam:WorldToViewportPoint(head.Position)
                    local headPos, onScreen1 = cam:WorldToViewportPoint(head.Position + Vector3.new(0, 1.15, 0))
                    local legPos, onScreen2 = cam:WorldToViewportPoint(root.Position - Vector3.new(0, 3.1, 0))

                    if headPos.Z > 0 and legPos.Z > 0 and (onScreen1 or onScreen2) then
                        local boxHeight = math.abs(headPos.Y - legPos.Y)
                        local boxWidth = boxHeight * 0.62
                        local boxPosX = headPos.X - (boxWidth * 0.5)
                        local boxPosY = headPos.Y

                        if Settings.ESPBoxes then
                            if Settings.ESPBoxStyle == "Corner" then
                                entry.Box.Visible = false
                                local cLen = math.clamp(boxWidth * 0.26, 4, 18)
                                local t = 1.5
                                local c = entry.Corners
                                c[1].Position = UDim2.fromOffset(boxPosX, boxPosY); c[1].Size = UDim2.fromOffset(cLen, t)
                                c[2].Position = UDim2.fromOffset(boxPosX, boxPosY); c[2].Size = UDim2.fromOffset(t, cLen)
                                c[3].Position = UDim2.fromOffset(boxPosX + boxWidth - cLen, boxPosY); c[3].Size = UDim2.fromOffset(cLen, t)
                                c[4].Position = UDim2.fromOffset(boxPosX + boxWidth - t, boxPosY); c[4].Size = UDim2.fromOffset(t, cLen)
                                c[5].Position = UDim2.fromOffset(boxPosX, boxPosY + boxHeight - t); c[5].Size = UDim2.fromOffset(cLen, t)
                                c[6].Position = UDim2.fromOffset(boxPosX, boxPosY + boxHeight - cLen); c[6].Size = UDim2.fromOffset(t, cLen)
                                c[7].Position = UDim2.fromOffset(boxPosX + boxWidth - cLen, boxPosY + boxHeight - t); c[7].Size = UDim2.fromOffset(cLen, t)
                                c[8].Position = UDim2.fromOffset(boxPosX + boxWidth - t, boxPosY + boxHeight - cLen); c[8].Size = UDim2.fromOffset(t, cLen)
                                for i = 1, 8 do
                                    c[i].BackgroundColor3 = primaryCol
                                    c[i].Visible = true
                                end
                            else
                                for i = 1, 8 do entry.Corners[i].Visible = false end
                                entry.Box.Size = UDim2.fromOffset(boxWidth, boxHeight)
                                entry.Box.Position = UDim2.fromOffset(boxPosX, boxPosY)
                                entry.BoxStroke.Color = primaryCol
                                entry.Box.Visible = true
                            end
                        else
                            entry.Box.Visible = false
                            for i = 1, 8 do entry.Corners[i].Visible = false end
                        end

                        if Settings.ESPHeadDot and headOnScreen then
                            entry.HeadDot.Position = UDim2.fromOffset(headCenter.X, headCenter.Y)
                            entry.HeadDot.BackgroundColor3 = primaryCol
                            entry.HeadDot.Visible = true
                        else
                            entry.HeadDot.Visible = false
                        end

                        if Settings.ESPTracers and (not Settings.ESPTracerOnlyTarget or isLocked) then
                            local startX, startY
                            if Settings.ESPTracerOrigin == "Center" then
                                startX, startY = viewportSize.X * 0.5, viewportSize.Y * 0.5
                            elseif Settings.ESPTracerOrigin == "Top" then
                                startX, startY = viewportSize.X * 0.5, 0
                            elseif Settings.ESPTracerOrigin == "Mouse" then
                                startX, startY = mousePos.X, mousePos.Y
                            else
                                startX, startY = viewportSize.X * 0.5, viewportSize.Y
                            end

                            local targetY = (Settings.ESPTracerOrigin == "Top") and boxPosY or legPos.Y
                            local dx, dy = headPos.X - startX, targetY - startY
                            entry.Tracer.Size = UDim2.fromOffset(math.sqrt(dx * dx + dy * dy), 1.3)
                            entry.Tracer.Position = UDim2.fromOffset((startX + headPos.X) * 0.5, (startY + targetY) * 0.5)
                            entry.Tracer.Rotation = math.deg(math.atan2(dy, dx))
                            entry.Tracer.BackgroundColor3 = isStaff and Settings.Red or (isLocked and Settings.AccentBright or Settings.TracerColor)
                            entry.Tracer.Visible = true
                        else
                            entry.Tracer.Visible = false
                        end

                        if Settings.ESPNames or Settings.ESPDistance then
                            local prefix = isStaff and "[STAFF] " or (isLocked and "[LOCK] " or (isWL and "[WL] " or ""))
                            local distStr = math.floor(studDist) .. "m"
                            if Settings.ESPNames and Settings.ESPDistance then
                                entry.Name.Text = string.format("%s%s(%s)", prefix, player.DisplayName, distStr)
                            elseif Settings.ESPNames then
                                entry.Name.Text = prefix .. player.DisplayName
                            else
                                entry.Name.Text = distStr
                            end
                            entry.Name.TextColor3 = isStaff and Settings.Red or Settings.ESPNameColor
                            entry.Name.Position = UDim2.fromOffset(headPos.X - 120, boxPosY - 16)
                            entry.Name.Visible = true
                        else
                            entry.Name.Visible = false
                        end

                        if Settings.ESPWeapon then
                            local tool = char:FindFirstChildOfClass("Tool")
                            entry.Weapon.Text = tool and ("[" .. tool.Name .. "]") or "[Unarmed]"
                            entry.Weapon.Position = UDim2.fromOffset(headPos.X - 100, boxPosY + boxHeight + 2)
                            entry.Weapon.Visible = true
                        else
                            entry.Weapon.Visible = false
                        end

                        if Settings.ESPHealth then
                            local pct = math.clamp(humanoid.Health / math.max(1, humanoid.MaxHealth), 0, 1)
                            local barH = boxHeight * pct
                            entry.HealthBg.Size = UDim2.fromOffset(3, boxHeight)
                            entry.HealthBg.Position = UDim2.fromOffset(boxPosX - 6, boxPosY)
                            entry.HealthFill.Size = UDim2.fromOffset(3, barH)
                            entry.HealthFill.Position = UDim2.fromOffset(0, boxHeight - barH)
                            entry.HealthFill.BackgroundColor3 = Settings.Red:Lerp(Settings.Green, pct)
                            entry.HealthBg.Visible = true
                        else
                            entry.HealthBg.Visible = false
                        end
                    else
                        entry.Box.Visible = false
                        for i = 1, 8 do entry.Corners[i].Visible = false end
                        entry.HeadDot.Visible = false
                        entry.Tracer.Visible = false
                        entry.Name.Visible = false
                        entry.Weapon.Visible = false
                        entry.HealthBg.Visible = false
                    end
                else
                    Fn.HideESP(State.ESPCache[player])
                end
            else
                Fn.HideESP(State.ESPCache[player])
            end
        end
    end
end

