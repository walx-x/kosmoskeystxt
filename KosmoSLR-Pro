function Fn.Create(class, props, parent)
    local obj = Instance.new(class)
    for k, v in pairs(props or {}) do obj[k] = v end
    obj.Parent = parent
    return obj
end

function Fn.Corner(obj, radius)
    return Fn.Create("UICorner", { CornerRadius = UDim.new(0, radius) }, obj)
end

function Fn.Stroke(obj, color, transparency)
    return Fn.Create("UIStroke", {
        Color = color or Settings.Border,
        Thickness = 1,
        Transparency = transparency or 0.25,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    }, obj)
end

function Fn.Tween(obj, info, props)
    if not Settings.MenuAnimations then
        for k, v in pairs(props) do obj[k] = v end
        return nil
    end
    local t = TweenService:Create(obj, info, props)
    t:Play()
    return t
end

function Fn.PlayUISound(soundId, volMult)
    if not Settings.UISounds then return end
    local s = Instance.new("Sound")
    s.SoundId = soundId or AssetsCfg.UI_CLICK_SOUND_ID
    s.Volume = (Settings.UISoundVolume / 100) * (volMult or 0.6)
    s.Parent = UI.ScreenGui
    s:Play()
    task.delay(1.5, function() if s then s:Destroy() end end)
end

function Fn.Label(parent, text, size, color, font, alignX)
    return Fn.Create("TextLabel", {
        BackgroundTransparency = 1,
        Text = text,
        TextColor3 = color or Settings.Text,
        TextSize = size or 11,
        Font = font or Enum.Font.GothamMedium,
        TextXAlignment = alignX or Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Center
    }, parent)
end

function Fn.MakeDraggable(frame)
    frame.Active = true
    local dragging, dragStart, startPos
    frame.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            dragStart = input.Position
            startPos = frame.Position
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = false
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
            local delta = input.Position - dragStart
            frame.Position = UDim2.new(
                startPos.X.Scale, startPos.X.Offset + delta.X,
                startPos.Y.Scale, startPos.Y.Offset + delta.Y
            )
        end
    end)
end

