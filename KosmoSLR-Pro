        keyBtn.MouseButton1Click:Connect(function()
            Fn.PlayUISound()
            listening = true
            keyBtn.Text = "..."
            keyBtn.TextColor3 = Settings.AccentBright
        end)

        UserInputService.InputBegan:Connect(function(input)
            if listening and input.UserInputType == Enum.UserInputType.Keyboard then
                local k = (input.KeyCode == Enum.KeyCode.Backspace or input.KeyCode == Enum.KeyCode.Escape) and nil or input.KeyCode
                bindKeySetter(k)
                keyBtn.Text = k and k.Name or "None"
                keyBtn.TextColor3 = Settings.SubText
                listening = false
            end
        end)
    end
    return row
