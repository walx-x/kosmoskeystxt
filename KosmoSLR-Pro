function Fn.AddInfoRow(parent, keyTxt, valTxt, idKey, valColor)
    local row = Fn.Create("Frame", { Size = UDim2.new(1, 0, 0, 16), BackgroundTransparency = 1 }, parent)
    local kLbl = Fn.Label(row, keyTxt, 10, Settings.SubText, Enum.Font.GothamMedium)
    kLbl.Size = UDim2.new(0.55, 0, 1, 0)

    local vLbl = Fn.Label(row, valTxt, 10, valColor or Settings.Text, Enum.Font.GothamBold, Enum.TextXAlignment.Right)
    vLbl.Position = UDim2.new(0.55, 0, 0, 0)
    vLbl.Size = UDim2.new(0.45, 0, 1, 0)

    if idKey then
        State.StatsLabelUpdaters[idKey] = function()
            local s = State.SessionStats
            if idKey == "CombatKills" then vLbl.Text = tostring(s.Kills)
            elseif idKey == "CombatDeaths" then vLbl.Text = tostring(s.Deaths)
            elseif idKey == "CombatKD" then vLbl.Text = string.format("%.2f", s.Kills / math.max(1, s.Deaths))
            elseif idKey == "CombatDMG" then vLbl.Text = tostring(s.DamageDealt)
            elseif idKey == "MoveSpeed" then vLbl.Text = string.format("%.1f studs/s", s.CurrentSpeed)
            elseif idKey == "MoveJumps" then vLbl.Text = tostring(s.Jumps)
            elseif idKey == "MoveDist" then vLbl.Text = string.format("%.0f studs", s.DistanceStuds)
            elseif idKey == "MoveTime" then
                vLbl.Text = string.format("%02d:%02d", math.floor(s.MovementTime / 60), math.floor(s.MovementTime % 60))
            elseif idKey == "AdminCount" then
                local cnt = Fn.CountDetectedAdmins()
                vLbl.Text = cnt > 0 and (cnt .. " Detected") or "0 (Clear)"
                vLbl.TextColor3 = cnt > 0 and Settings.Red or Settings.Green
            end
        end
    end
    return vLbl
end

