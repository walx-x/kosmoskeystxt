function Fn.InitTabsAndKeybinds()
    local tabsData = {
        { Name = "Combat", Icon = AssetsCfg.TAB_ICONS.Combat, Render = Fn.RenderCombat },
        { Name = "Visuals", Icon = AssetsCfg.TAB_ICONS.Visuals, Render = Fn.RenderVisuals },
        { Name = "Players", Icon = AssetsCfg.TAB_ICONS.Players, Render = Fn.RenderPlayers },
        { Name = "Weapon", Icon = AssetsCfg.TAB_ICONS.Weapon, Render = Fn.RenderWeapon },
        { Name = "Movement", Icon = AssetsCfg.TAB_ICONS.Movement, Render = Fn.RenderMovement },
        { Name = "Misc", Icon = AssetsCfg.TAB_ICONS.Misc, Render = Fn.RenderMisc },
        { Name = "Settings", Icon = AssetsCfg.TAB_ICONS.Settings, Render = Fn.RenderSettings }
    }

    Fn.SelectTab = function(name)
        State.ActiveTabName = name
        for tName, tObj in pairs(UI.TabButtons) do
            local isSel = (tName == name)
            Fn.Tween(tObj.Btn, UI.FastTween, { BackgroundTransparency = isSel and 0.4 or 1 })
            Fn.Tween(tObj.Txt, UI.FastTween, { TextColor3 = isSel and Settings.Text or Settings.SubText })
            Fn.Tween(tObj.Icon, UI.FastTween, { ImageColor3 = isSel and Settings.AccentBright or Settings.SubText })
            Fn.Tween(tObj.Line, UI.FastTween, { BackgroundColor3 = Settings.Accent, BackgroundTransparency = isSel and 0 or 1 })
        end
        for _, t in ipairs(tabsData) do
            if t.Name == name then t.Render(); break end
        end
    end

    for i, t in ipairs(tabsData) do
        local btn = Fn.Create("TextButton", {
            Size = UDim2.fromOffset(84, 26),
            Position = UDim2.fromOffset(0, 2),
            BackgroundColor3 = Settings.BgControl,
            BackgroundTransparency = 1,
            BorderSizePixel = 0,
            Text = "",
            AutoButtonColor = false,
            LayoutOrder = i
        }, UI.TabContainer)
        Fn.Corner(btn, 4)

        local icon = Fn.Create("ImageLabel", {
            Size = UDim2.fromOffset(11, 11),
            Position = UDim2.fromOffset(8, 7),
            BackgroundTransparency = 1,
            Image = t.Icon,
            ImageColor3 = Settings.SubText
        }, btn)

        local txt = Fn.Label(btn, t.Name, 9, Settings.SubText, Enum.Font.GothamMedium)
        txt.Position = UDim2.fromOffset(23, 0)
        txt.Size = UDim2.new(1, -25, 1, 0)

        local line = Fn.Create("Frame", {
            Size = UDim2.new(1, -10, 0, 2),
            Position = UDim2.new(0, 5, 1, -2),
            BackgroundColor3 = Settings.Accent,
            BackgroundTransparency = 1,
            BorderSizePixel = 0
        }, btn)

        UI.TabButtons[t.Name] = { Btn = btn, Icon = icon, Txt = txt, Line = line }
        btn.MouseButton1Click:Connect(function() Fn.PlayUISound(); Fn.SelectTab(t.Name) end)
    end

    table.insert(State.Connections, UserInputService.InputBegan:Connect(function(input, processed)
        if input.UserInputType == Enum.UserInputType.MouseButton1 and not processed then
            State.SessionStats.LastAttackTick = tick()
            if Settings.ClickTP then
                if Settings.ClickTPKey == nil or UserInputService:IsKeyDown(Settings.ClickTPKey) then
                    Fn.ExecuteClickTP()
                end
            end
        end
        if processed then return end

        if Settings.PanicKey and input.KeyCode == Settings.PanicKey then
            Fn.TogglePanicMode()
        elseif Settings.ToggleKey and input.KeyCode == Settings.ToggleKey then
            if State.PanicActive then Fn.TogglePanicMode() else Fn.SetMenuVisible(not UI.Main.Visible) end
        elseif Settings.UnloadKey and input.KeyCode == Settings.UnloadKey then
            Fn.UnloadScript()
        elseif Settings.SilentKey and input.KeyCode == Settings.SilentKey then
            Settings.Enabled = not Settings.Enabled
            if State.ToggleUpdaters["Enabled"] then State.ToggleUpdaters["Enabled"](Settings.Enabled) end
            Fn.Notify("KoSMO Hub", "Silent Aim " .. (Settings.Enabled and "Enabled" or "Disabled"))
        elseif Settings.CustomPartKey and input.KeyCode == Settings.CustomPartKey then
            Settings.CustomPart = not Settings.CustomPart
            if State.ToggleUpdaters["Custom Part (Closest)"] then State.ToggleUpdaters["Custom Part (Closest)"](Settings.CustomPart) end
        elseif Settings.AimbotKey and input.KeyCode == Settings.AimbotKey then
            Settings.AimbotEnabled = not Settings.AimbotEnabled
            if not Settings.AimbotEnabled then State.CurrentAimbotTargetPlayer = nil end
            if State.ToggleUpdaters["Aimbot Enabled"] then State.ToggleUpdaters["Aimbot Enabled"](Settings.AimbotEnabled) end
            Fn.Notify("KoSMO Hub", "Aimbot " .. (Settings.AimbotEnabled and "Enabled" or "Disabled"))
        elseif Settings.AimbotCustomPartKey and input.KeyCode == Settings.AimbotCustomPartKey then
            Settings.AimbotCustomPart = not Settings.AimbotCustomPart
            if State.ToggleUpdaters["Aimbot Custom Part"] then State.ToggleUpdaters["Aimbot Custom Part"](Settings.AimbotCustomPart) end
        elseif Settings.AimbotWallCheckKey and input.KeyCode == Settings.AimbotWallCheckKey then
            Settings.AimbotWallCheck = not Settings.AimbotWallCheck
            if State.ToggleUpdaters["Aimbot Wall Check"] then State.ToggleUpdaters["Aimbot Wall Check"](Settings.AimbotWallCheck) end
        elseif Settings.RageKey and input.KeyCode == Settings.RageKey then
            Settings.RageMode = not Settings.RageMode
            if not Settings.RageMode then State.CurrentRageTarget = nil end
            if State.ToggleUpdaters["Enable Rage Mode"] then State.ToggleUpdaters["Enable Rage Mode"](Settings.RageMode) end
            Fn.Notify("Rage Mode", Settings.RageMode and "Synced with Aimbot target" or "Disabled")
        elseif Settings.ESPKey and input.KeyCode == Settings.ESPKey then
            Settings.ESPEnabled = not Settings.ESPEnabled
            if State.ToggleUpdaters["Enable ESP"] then State.ToggleUpdaters["Enable ESP"](Settings.ESPEnabled) end
            Fn.Notify("KoSMO Hub", "ESP " .. (Settings.ESPEnabled and "Enabled" or "Disabled"))
        elseif Settings.WalkSpeedKey and input.KeyCode == Settings.WalkSpeedKey then
            Settings.EnableWalkSpeed = not Settings.EnableWalkSpeed
            if not Settings.EnableWalkSpeed then Fn.RestoreWalkSpeedState() end
            if State.ToggleUpdaters["Enable WalkSpeed"] then State.ToggleUpdaters["Enable WalkSpeed"](Settings.EnableWalkSpeed) end
        end
    end))
end

function Fn.InitRuntimeConnections()
    local function hookEnemyHumanoid(hum)
        if not hum or State.TrackedHumanoids[hum] then return end
        State.TrackedHumanoids[hum] = true
        local lastHp, killCounted = hum.Health, false
        hum.HealthChanged:Connect(function(newHp)
            local diff = lastHp - newHp
            if diff > 0 then
                local hasTool = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Tool") ~= nil
                local recentlyAttacked = (tick() - State.SessionStats.LastAttackTick) <= 1.75
                if hasTool or recentlyAttacked or Settings.Enabled or Settings.AimbotEnabled or Settings.RageMode then
                    State.SessionStats.DamageDealt += math.floor(diff + 0.5)
                    Fn.TriggerHitmarker()
                    if newHp <= 0 and not killCounted then
                        killCounted = true
                        State.SessionStats.Kills += 1
                    end
                end
            end
            lastHp = newHp
        end)
    end

    local function watchPlayer(player)
        if player == LocalPlayer then return end
        if player.Character then
            local hum = player.Character:FindFirstChildWhichIsA("Humanoid")
            if hum then hookEnemyHumanoid(hum) end
        end
        player.CharacterAdded:Connect(function(char)
            local hum = char:WaitForChild("Humanoid", 5)
            if hum then hookEnemyHumanoid(hum) end
        end)
    end

    for _, p in ipairs(Players:GetPlayers()) do watchPlayer(p) end
    table.insert(State.Connections, Players.PlayerAdded:Connect(function(plr)
        watchPlayer(plr)
        Fn.InspectPlayerForAdmin(plr, false)
    end))

    table.insert(State.Connections, Players.PlayerRemoving:Connect(function(plr)
        Fn.RemoveESP(plr)
        State.DetectedAdmins[plr] = nil
        if State.CurrentAimbotTargetPlayer == plr then State.CurrentAimbotTargetPlayer = nil end
        if State.CurrentSilentTargetPlayer == plr then State.CurrentSilentTargetPlayer = nil end
        if State.CurrentRageTarget == plr then State.CurrentRageTarget = nil end
        if State.SelectedPlayerObj == plr then State.SelectedPlayerObj = nil end
        if State.SpectatingPlayer == plr then
            State.SpectatingPlayer = nil
            local cam = Fn.GetCamera()
            local hum = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildWhichIsA("Humanoid")
            if cam and hum then cam.CameraSubject = hum end
        end
    end))

    table.insert(State.Connections, workspace.DescendantAdded:Connect(function(obj)
        if Settings.FPSBoost and obj:IsA("BasePart") then
            if not State.OriginalMaterials[obj] then State.OriginalMaterials[obj] = obj.Material end
            obj.Material = Enum.Material.SmoothPlastic
        end
        if Settings.NoDecals and (obj:IsA("Decal") or obj:IsA("Texture")) then
            if State.OriginalTransparencies[obj] == nil then State.OriginalTransparencies[obj] = obj.Transparency end
            obj.Transparency = 1
        end
    end))

    table.insert(State.Connections, game.DescendantAdded:Connect(function(obj)
        if obj:IsA("Sound") then
            if Settings.CustomGunAudio or Settings.CustomSkitsAudio then task.defer(Fn.ProcessSound, obj) end
        elseif Settings.CustomAR15Skin or Settings.CustomSMGSkin or Settings.CustomSparksTexture or Settings.CustomSkybox then
            task.defer(Fn.ProcessAssetObject, obj)
        end
    end))

    local lastJumpTick = 0
    local function setupChar(char)
        if not char then return end
        table.clear(State.OriginalCollideStates)
        for _, tool in ipairs(char:GetChildren()) do Fn.ApplyToTool(tool) end
        char.ChildAdded:Connect(function(c)
            if c:IsA("Tool") then
                task.wait(0.05)
                Fn.ApplyToTool(c)
                if Settings.CustomAR15Skin or Settings.CustomSMGSkin then
                    for _, d in ipairs(c:GetDescendants()) do Fn.ProcessAssetObject(d) end
                end
            end
        end)
        if Settings.GhostMode then task.delay(0.1, function() Fn.ApplyGhostMode(true) end) end

        local hum = char:WaitForChild("Humanoid", 5)
        if hum then
            hum.Died:Connect(function() State.SessionStats.Deaths += 1 end)
            hum.Jumping:Connect(function(active)
                if active and (tick() - lastJumpTick) > 0.25 then
                    lastJumpTick = tick(); State.SessionStats.Jumps += 1
                end
            end)
        end

        local bp = LocalPlayer:WaitForChild("Backpack", 5)
        if bp then
            for _, tool in ipairs(bp:GetChildren()) do Fn.ApplyToTool(tool) end
            bp.ChildAdded:Connect(function(c)
                if c:IsA("Tool") then
                    task.wait(0.05)
                    Fn.ApplyToTool(c)
                    if Settings.CustomAR15Skin or Settings.CustomSMGSkin then
                        for _, d in ipairs(c:GetDescendants()) do Fn.ProcessAssetObject(d) end
                    end
                end
            end)
        end
        task.delay(0.8, Fn.ApplyHeadshots)
    end

    if LocalPlayer.Character then setupChar(LocalPlayer.Character) end
    table.insert(State.Connections, LocalPlayer.CharacterAdded:Connect(setupChar))

    task.spawn(function()
        pcall(function()
            local scMod = ReplicatedStorage:WaitForChild("SimpleCast", 5)
            if scMod then
                local sc = require(scMod)
                if sc and sc.Fire then
                    local origFire = sc.Fire
                    sc.Fire = function(self, origin, direction, speed, options)
                        State.SessionStats.LastAttackTick = tick()
                        if Settings.Enabled then
                            local targetPart = Fn.FindClosestTarget(Fn.GetCurrentFOV(), Settings.CustomPart, Settings.WallCheck)
                            if targetPart and (Settings.HitProbability >= 100 or math.random(1, 100) <= Settings.HitProbability) then
                                direction = (targetPart.Position - origin).Unit
                            end
                        end
                        return origFire(self, origin, direction, speed, options)
                    end
                end
            end
        end)
    end)

    table.insert(State.Connections, RunService.Stepped:Connect(function()
        local char = LocalPlayer.Character
        if not char then return end
        local hum = char:FindFirstChildWhichIsA("Humanoid")
        local root = char:FindFirstChild("HumanoidRootPart")

        if hum and Settings.EnableWalkSpeed then hum.WalkSpeed = math.clamp(Settings.WalkSpeed, 6, 45) end
        if root then
            if Settings.FlyEnabled and not Settings.RageMode then
                local cam = Fn.GetCamera()
                if cam then
                    local flyVec = Vector3.zero
                    if UserInputService:IsKeyDown(Enum.KeyCode.W) then flyVec += cam.CFrame.LookVector end
                    if UserInputService:IsKeyDown(Enum.KeyCode.S) then flyVec -= cam.CFrame.LookVector end
                    if UserInputService:IsKeyDown(Enum.KeyCode.A) then flyVec -= cam.CFrame.RightVector end
                    if UserInputService:IsKeyDown(Enum.KeyCode.D) then flyVec += cam.CFrame.RightVector end
                    if UserInputService:IsKeyDown(Enum.KeyCode.Space) then flyVec += Vector3.yAxis end
                    if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then flyVec -= Vector3.yAxis end
                    root.AssemblyLinearVelocity = Vector3.zero
                    if flyVec.Magnitude > 0 then
                        root.CFrame += (flyVec.Unit * (math.clamp(Settings.FlySpeed, 1, 15) * 0.4))
                    end
                end
            end
            if Settings.Spinbot and not Settings.RageMode then
                root.CFrame *= CFrame.Angles(0, math.rad(Settings.SpinSpeed), 0)
            end
        end

        local noclipNeeded = Settings.Noclip or Settings.FlyEnabled or Settings.RageMode
        if noclipNeeded or Settings.GhostMode then
            for _, part in ipairs(char:GetDescendants()) do
                if part:IsA("BasePart") then
                    if noclipNeeded then
                        if State.OriginalCollideStates[part] == nil then State.OriginalCollideStates[part] = part.CanCollide end
                        part.CanCollide = false
                    end
                    if Settings.GhostMode and part.Name ~= "HumanoidRootPart" then part.LocalTransparencyModifier = 0.65 end
                end
            end
            State.WasNoclipActive = noclipNeeded
        elseif State.WasNoclipActive then
            State.WasNoclipActive = false
            Fn.RestoreNoclipState()
        end
    end))

    table.insert(State.Connections, RunService.Heartbeat:Connect(function(dt)
        if Settings.RageMode then Fn.UpdateRageMode() end
        local char = LocalPlayer.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        local hum = char and char:FindFirstChildWhichIsA("Humanoid")
        if root and hum then
            local flatVel = Vector3.new(root.AssemblyLinearVelocity.X, 0, root.AssemblyLinearVelocity.Z).Magnitude
            State.SessionStats.CurrentSpeed = math.floor(flatVel * 10) / 10
            if flatVel > 1.2 or hum.MoveDirection.Magnitude > 0.05 then
                State.SessionStats.MovementTime += dt
                State.SessionStats.DistanceStuds += flatVel * dt
            end
        else
            State.SessionStats.CurrentSpeed = 0
        end
    end))

    local currentFPS, fpsTimer, frameCounter = 60, 0, 0
    table.insert(State.Connections, RunService.RenderStepped:Connect(function(dt)
        frameCounter += 1
        fpsTimer += dt
        if fpsTimer >= 0.4 then
            currentFPS = math.floor(frameCounter / fpsTimer)
            frameCounter, fpsTimer = 0, 0

            local ping = 0
            pcall(function() ping = math.floor(StatsService.Network.ServerStatsItem["Data Ping"]:GetValue()) end)
            local cam = Fn.GetCamera()
            local curFOV = cam and math.floor(cam.FieldOfView) or 70
            local themeHex = (Themes[Settings.ThemeName] and Themes[Settings.ThemeName].Hex) or "#9b5cff"
            local staffCount = Fn.CountDetectedAdmins()

            if Settings.ShowWatermark and not State.PanicActive then
                local staffTag = (Settings.AdminDetector and staffCount > 0)
                    and string.format('  <font color="#504868">|</font>  <font color="#ee526c"><b>STAFF: %d</b></font>', staffCount) or ""
                UI.WMText.Text = string.format('<font color="%s"><b>KoSMO</b></font>  <font color="#504868">|</font>  %d fps  <font color="#504868">|</font>  %d ms  <font color="#504868">|</font>  %s  <font color="#504868">|</font>  %s%s', themeHex, currentFPS, ping, os.date("%H:%M:%S"), LocalPlayer.Name, staffTag)
            end

            UI.PerfCard.Visible = Settings.PerformanceOverlay and not State.PanicActive
            if UI.PerfCard.Visible then
                UI.PerfText.Text = string.format("FPS: %d  |  Ping: %dms%s", currentFPS, ping, Settings.ShowFOVDisplay and ("  |  FOV: " .. curFOV) or "")
            elseif Settings.ShowFOVDisplay and not State.PanicActive then
                UI.PerfCard.Visible = true
                UI.PerfText.Text = "Camera FOV: " .. curFOV .. "°"
            end

            UI.CombatHUDCard.Visible = Settings.ShowCombatStatsHUD and not State.PanicActive
            local s = State.SessionStats
            if UI.CombatHUDCard.Visible then
                UI.CombatHUDText.Text = string.format("K: %d  |  D: %d  |  K/D: %.2f  |  DMG: %d", s.Kills, s.Deaths, s.Kills / math.max(1, s.Deaths), s.DamageDealt)
            end

            UI.MoveHUDCard.Visible = Settings.ShowMovementHUD and not State.PanicActive
            if UI.MoveHUDCard.Visible then
                UI.MoveHUDText.Text = string.format("Spd: %.1f  |  Jumps: %d  |  %02d:%02d", s.CurrentSpeed, s.Jumps, math.floor(s.MovementTime / 60), math.floor(s.MovementTime % 60))
            end

            for _, upd in pairs(State.StatsLabelUpdaters) do pcall(upd) end
        end

        UI.KeyDisplayFrame.Visible = Settings.ShowKeyDisplay and not State.PanicActive
        if UI.KeyDisplayFrame.Visible then
            local kStates = {
                W = UserInputService:IsKeyDown(Enum.KeyCode.W),
                A = UserInputService:IsKeyDown(Enum.KeyCode.A),
                S = UserInputService:IsKeyDown(Enum.KeyCode.S),
                D = UserInputService:IsKeyDown(Enum.KeyCode.D),
                SPACE = UserInputService:IsKeyDown(Enum.KeyCode.Space),
                LMB = UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1)
            }
            for k, active in pairs(kStates) do
                local tile = UI.KeyBoxes[k]
                if tile then
                    tile.Frame.BackgroundColor3 = active and Settings.Accent or Settings.BgMain
                    tile.Stroke.Color = active and Settings.AccentBright or Settings.Border
                    tile.Label.TextColor3 = active and Color3.new(1, 1, 1) or Settings.SubText
                end
            end
        end

        local activeFOV = Fn.GetCurrentFOV()
        local mousePos = Fn.GetMousePosition()

        UI.CrosshairHolder.Visible = Settings.CrosshairEnabled and not State.PanicActive
        if UI.CrosshairHolder.Visible then
            if Settings.CrosshairFollowMouse then
                UI.CrosshairHolder.Position = UDim2.fromOffset(mousePos.X, mousePos.Y)
            else
                local cam = Fn.GetCamera()
                if cam then UI.CrosshairHolder.Position = UDim2.fromOffset(cam.ViewportSize.X * 0.5, cam.ViewportSize.Y * 0.5) end
            end
        end

        if Settings.RainbowFOV then Settings.FOVColor = Color3.fromHSV((tick() % 5) / 5, 0.75, 1) end
        if Settings.AimbotRainbowFOV then Settings.AimbotFOVColor = Color3.fromHSV((tick() % 5) / 5, 0.75, 1) end

        if Settings.Enabled and Settings.ShowFOV and not State.PanicActive then
            UI.FOVFrame.Visible = true
            UI.FOVFrame.Size = UDim2.fromOffset(activeFOV * 2, activeFOV * 2)
            UI.FOVFrame.Position = UDim2.fromOffset(mousePos.X, mousePos.Y)
            UI.FOVStroke.Color = Settings.FOVColor
        else
            UI.FOVFrame.Visible = false
        end

        if Settings.AimbotEnabled and Settings.AimbotShowFOV and not State.PanicActive then
            UI.AimbotFOVFrame.Visible = true
            UI.AimbotFOVFrame.Size = UDim2.fromOffset(Settings.AimbotFOV * 2, Settings.AimbotFOV * 2)
            UI.AimbotFOVFrame.Position = UDim2.fromOffset(mousePos.X, mousePos.Y)
            UI.AimbotFOVStroke.Color = Settings.AimbotFOVColor
        else
            UI.AimbotFOVFrame.Visible = false
        end

        if Settings.Enabled then
            local _, bestScreenPos, silentPlr = Fn.FindClosestTarget(activeFOV, Settings.CustomPart, Settings.WallCheck)
            State.CurrentSilentTargetPlayer = silentPlr
            if Settings.ShowDot and bestScreenPos and not State.PanicActive then
                UI.TargetDotFrame.Visible = true
                UI.TargetDotFrame.Position = UDim2.fromOffset(bestScreenPos.X, bestScreenPos.Y)
                UI.TargetDotFrame.BackgroundColor3 = Settings.TargetColor
            else
                UI.TargetDotFrame.Visible = false
            end
        else
            State.CurrentSilentTargetPlayer = nil
            UI.TargetDotFrame.Visible = false
        end

        if Settings.AimbotEnabled then
            local abPart, abScreenPos, abPlayer = Fn.FindClosestTarget(Settings.AimbotFOV, Settings.AimbotCustomPart, Settings.AimbotWallCheck)
            if abPlayer then
                State.CurrentAimbotTargetPlayer = abPlayer
                if abPart and abScreenPos then Fn.RunAimbot(abPart, abScreenPos) end
            elseif Settings.RageMode and Settings.RageTargetMode == "Aimbot Locked" and Fn.IsValidRageTarget(State.CurrentRageTarget) then
                State.CurrentAimbotTargetPlayer = State.CurrentRageTarget
                local rChar = State.CurrentRageTarget.Character
                local rPart = rChar and (rChar:FindFirstChild("Head") or rChar:FindFirstChild("HumanoidRootPart"))
                local cam = Fn.GetCamera()
                if rPart and cam then
                    local sp, onScr = cam:WorldToViewportPoint(rPart.Position)
                    if onScr and sp.Z > 0 then Fn.RunAimbot(rPart, Vector2.new(sp.X, sp.Y)) end
                end
            else
                State.CurrentAimbotTargetPlayer = nil
            end
        else
            State.CurrentAimbotTargetPlayer = nil
        end

        Fn.UpdateESP()
    end))

    table.insert(State.Connections, LocalPlayer.Idled:Connect(function()
        if Settings.AntiAFK then
            VirtualUser:Button2Down(Vector2.zero, workspace.CurrentCamera.CFrame)
            task.wait(1)
            VirtualUser:Button2Up(Vector2.zero, workspace.CurrentCamera.CFrame)
        end
    end))
end

