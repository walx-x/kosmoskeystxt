function Fn.AddButton(parent, text, isDanger, callback)
    local btn = Fn.Create("TextButton", { Size = UDim2.new(1, 0, 0, 24), BackgroundColor3 = isDanger and Color3.fromRGB(45, 18, 26) or Settings.BgControl, BorderSizePixel = 0, Text = text, TextColor3 = isDanger and Settings.Red or Settings.Text, TextSize = 10, Font = Enum.Font.GothamBold, AutoButtonColor = false }, parent)
