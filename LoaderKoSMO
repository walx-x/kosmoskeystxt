--============================================================

VerifyBtn.MouseButton1Click:Connect(function()
    local userTypedKey = KeyInput.Text:gsub("%s+", "")
    if userTypedKey == "" then
        StatusLbl.Text = "Please enter a valid key!"
        StatusLbl.TextColor3 = Color3.fromRGB(240, 75, 100)
        return
    end

    VerifyBtn.Text = "VERIFYING..."
    StatusLbl.Text = "Checking HWID and validity..."
    StatusLbl.TextColor3 = Color3.fromRGB(200, 200, 200)

    task.spawn(function()
        local success, message = VerifyKeyOnline(userTypedKey)
        if success then
            StatusLbl.Text = "Valid Key! Checking game..."
            StatusLbl.TextColor3 = Color3.fromRGB(80, 220, 135)
            
            task.wait(0.2)
            local scriptUrl = GetScriptForCurrentGame()
            
            if scriptUrl then
                StatusLbl.Text = "Supported game! Launching..."
                task.wait(0.3)
                ScreenGui:Destroy()
                LaunchGameScript(scriptUrl)
            else
                StatusLbl.Text = "Game not supported at the moment!"
                StatusLbl.TextColor3 = Color3.fromRGB(240, 75, 100)
                VerifyBtn.Text = "VERIFY KEY"
            end
        else
            StatusLbl.Text = message
            StatusLbl.TextColor3 = Color3.fromRGB(240, 75, 100)
            VerifyBtn.Text = "VERIFY KEY"
        end
    end)
end)
