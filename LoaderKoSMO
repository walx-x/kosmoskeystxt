local KEY_FILE = "KosmosKey.txt"
local JSON_KEYS_URL = "https://raw.githubusercontent.com/walx-x/kosmoskeystxt/refs/heads/main/KosmosPaidKeys.json"

--============================================================
-- SUPPORTED GAMES CONFIGURATION (PlaceId -> Raw Github URL)
--============================================================
local SupportedGames = {
    -- South London Remastered
    [114478751418135] = "https://raw.githubusercontent.com/walx-x/kosmoskeystxt/refs/heads/main/KoSMO-SLR",
    
    -- Hood Rivals
    [77463332823746]  = "https://raw.githubusercontent.com/walx-x/kosmoskeystxt/refs/heads/main/KoSMO-SLR",
}

--============================================================
-- HELPER FUNCTIONS & FILE MANAGEMENT
--============================================================

local function GetSavedKey()
    if isfile and readfile and isfile(KEY_FILE) then
        local success, result = pcall(function() return readfile(KEY_FILE) end)
        if success and result then return result:gsub("%s+", "") end
    end
    return nil
end

local function SaveKeyLocally(key)
    if writefile then
        pcall(function() writefile(KEY_FILE, key) end)
    end
end

local function DeleteSavedKey()
    if delfile and isfile and isfile(KEY_FILE) then
        pcall(function() delfile(KEY_FILE) end)
    end
end

local function GetScriptForCurrentGame()
    local placeId = game.PlaceId
    return SupportedGames[placeId]
end

local function LaunchGameScript(scriptUrl)
    task.spawn(function()
        local success, err = pcall(function()
            local code = game:HttpGet(scriptUrl .. "?nocache=" .. tostring(os.time()))
            loadstring(code)()
        end)
        if not success then
            warn("[KOSMOS LOADER ERROR]: " .. tostring(err))
        end
    end)
end

--============================================================
-- KEY VERIFICATION ENGINE (HWID & JSON CHECK)
--============================================================

local function VerifyKeyOnline(userKey)
    local success, response = pcall(function()
        return game:HttpGet(JSON_KEYS_URL .. "?nocache=" .. tostring(os.time()))
    end)

    if not success or not response then
        return false, "Database connection error!"
    end

    local dbSuccess, keysData = pcall(function()
        return HttpService:JSONDecode(response)
    end)

    if not dbSuccess or type(keysData) ~= "table" then
        return false, "Invalid key database format!"
    end

    local keyInfo = keysData[userKey]
    if not keyInfo then
        return false, "Invalid or non-existent key!"
    end

    -- HWID and Usage Status Check
    if keyInfo.used == true and keyInfo.hwid ~= "" and keyInfo.hwid ~= HWID then
        return false, "Key already used on another device!"
    end

    -- If the key is available or already belongs to this HWID
    SaveKeyLocally(userKey)
    return true, "Authentication successful!"
end

--============================================================
-- STARTUP AUTO-LOGIN CHECK
--============================================================

local savedKey = GetSavedKey()
if savedKey then
    local isValid, msg = VerifyKeyOnline(savedKey)
    if isValid then
        local gameScriptUrl = GetScriptForCurrentGame()
        if gameScriptUrl then
            -- Instant loading without UI
            LaunchGameScript(gameScriptUrl)
            return
        end
    else
        DeleteSavedKey()
    end
end

