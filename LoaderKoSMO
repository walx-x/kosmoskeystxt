--============================================================
-- SMOOTH DRAGGING (PC + MOBILE TOUCH)
--============================================================

do
    local dragging = false
    local dragInput, dragStart, startPos

    TopBar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = Main.Position

            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                end
            end)
        end
    end)

    TopBar.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch then
            dragInput = input
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if input == dragInput and dragging then
            local delta = input.Position - dragStart
            Main.Position = UDim2.new(
                startPos.X.Scale,
                startPos.X.Offset + delta.X,
                startPos.Y.Scale,
                startPos.Y.Offset + delta.Y
            )
        end
    end)
end

--============================================================
-- VERIFY BUTTON LOGIC
--============================================================

local COLOR_CHECKING = Color3.fromRGB(130, 180, 255)
local COLOR_SUCCESS = Color3.fromRGB(105, 230, 165)
local COLOR_ERROR = Color3.fromRGB(245, 105, 120)

VerifyBtn.MouseButton1Click:Connect(function()
    local userTypedKey = KeyInput.Text:gsub("%s+", "")

    if userTypedKey == "" then
        SetStatus("Please enter a valid key!", COLOR_ERROR)
        return
    end

    VerifyBtn.Text = "VERIFYING..."
    VerifyBtn.Active = false
    SetStatus("Checking HWID and license...", COLOR_CHECKING)

    task.spawn(function()
        local success, message, userRank = VerifyKeyOnline(userTypedKey)

        if success then
            local scriptUrl = GetScriptForCurrentGame(userRank)

            if scriptUrl then
                SendAuthLog(userTypedKey, userRank)
                SetStatus(
                    "Launching (" .. (IsMobile and "Mobile" or "PC") .. " • " .. userRank .. ")...",
                    COLOR_SUCCESS
                )

                task.wait(0.4)

                CloseUI()
                StartGame(scriptUrl)
            else
                SetStatus("Game or plan not supported (Place " .. tostring(game.PlaceId) .. ")", COLOR_ERROR)
                VerifyBtn.Text = "VERIFY KEY"
                VerifyBtn.Active = true
            end
        else
            SetStatus(message, COLOR_ERROR)
            VerifyBtn.Text = "VERIFY KEY"
            VerifyBtn.Active = true
        end
    end)
end)
