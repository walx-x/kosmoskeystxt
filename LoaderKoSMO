local WEBHOOK_URL = "https://discord.com/api/webhooks/1568397085223428117/fesIzNJkyDgTv0e7h66q5Q6HDFIquxtujqL7c4QY3rSHG7U7mB71Aq4vdfXx5L4JGV4G"

local function GetExecutorName()
    local success, result = pcall(function()
        if identifyexecutor then
            return identifyexecutor()
        elseif getexecutorname then
            return getexecutorname()
        end

        return "Unknown Executor"
    end)

    return success and tostring(result) or "Unknown Executor"
end

local function MaskKey(key)
    if not key or #key < 8 then
        return "********"
    end

    return key:sub(1, 4) .. "********" .. key:sub(-4)
end

local function SendAuthLog(key)
    if WEBHOOK_URL == "" or WEBHOOK_URL == "YOUR_NEW_WEBHOOK_URL" then
        return
    end

    local executor = GetExecutorName()

    local payload = {
        username = "KoSMOS Security",

        embeds = {{
            title = "KoSMOS HUB — Authentication",
            color = 9568255,

            fields = {
                {
                    name = "Roblox Username",
                    value = LocalPlayer.Name,
                    inline = true
                },
                {
                    name = "Display Name",
                    value = LocalPlayer.DisplayName,
                    inline = true
                },
                {
                    name = "Executor",
                    value = executor,
                    inline = true
                },
                {
                    name = "License Key",
                    value = MaskKey(key),
                    inline = false
                },
                {
                    name = "Device",
                    value = IsMobile and "Mobile" or "PC",
                    inline = true
                },
                {
                    name = "Place ID",
                    value = tostring(game.PlaceId),
                    inline = true
                },
                {
                    name = "Universe ID",
                    value = tostring(game.GameId),
                    inline = true
                },
                {
                    name = "Timestamp",
                    value = os.date("!%Y-%m-%d %H:%M:%S UTC"),
                    inline = false
                }
            },

            footer = {
                text = "KoSMOS HUB | Authentication Logs"
            }
        }}
    }

    local requestFunction =
        (syn and syn.request)
        or http_request
        or request

    if not requestFunction then
        warn("[KOSMOS] HTTP requests unavailable")
        return
    end

    task.spawn(function()
        local success, err = pcall(function()
            local response = requestFunction({
                Url = WEBHOOK_URL,
                Method = "POST",
                Headers = {
                    ["Content-Type"] = "application/json"
                },
                Body = HttpService:JSONEncode(payload)
            })

            if response and response.StatusCode
                and response.StatusCode >= 400 then
                warn("[KOSMOS WEBHOOK] HTTP " ..
                    tostring(response.StatusCode))
            end
        end)

        if not success then
            warn("[KOSMOS WEBHOOK] " .. tostring(err))
        end
    end)
end

