    dropGrad.Rotation = 90
    dropGrad.Transparency = NumberSequence.new({
        NumberSequenceKeypoint.new(0, 1),
        NumberSequenceKeypoint.new(0.45, 0.25),
        NumberSequenceKeypoint.new(1, 0)
