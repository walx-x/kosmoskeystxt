--============================================================
-- GAME DETECTION
--============================================================

local UniverseCache = {}

local function GetUniverseIdFromPlace(placeId)
    if UniverseCache[placeId] then
        return UniverseCache[placeId]
    end

    local ok, universeId = pcall(function()
        local raw = game:HttpGet(
            "https://apis.roblox.com/universes/v1/places/"
            .. tostring(placeId) .. "/universe"
        )

        return HttpService:JSONDecode(raw).universeId
    end)

    if ok and type(universeId) == "number" then
        UniverseCache[placeId] = universeId
        return universeId
    end

    return nil
end

local function FindGameEntry()
    local placeId = game.PlaceId
    local gameId = game.GameId

    if SupportedGames[placeId] then
        return SupportedGames[placeId]
    end

    if ExtraUniverses[gameId] then
        return ExtraUniverses[gameId]
    end

    for knownPlaceId, data in pairs(SupportedGames) do
        if GetUniverseIdFromPlace(knownPlaceId) == gameId then
            return data
        end
    end

    return nil
end

--============================================================
-- FILE MANAGEMENT
--============================================================

local function GetSavedKey()
    if isfile and readfile and isfile(KEY_FILE) then
        local success, result = pcall(function()
            return readfile(KEY_FILE)
        end)

        if success and result then
            return result:gsub("%s+", "")
        end
    end

    return nil
end

local function SaveKeyLocally(key)
    if writefile then
        pcall(function()
            writefile(KEY_FILE, key)
        end)
    end
end

local function DeleteSavedKey()
    if delfile and isfile and isfile(KEY_FILE) then
        pcall(function()
            delfile(KEY_FILE)
        end)
    end
end

--============================================================
-- GAME SCRIPT
--============================================================

local function GetScriptForCurrentGame()
    local gameData = FindGameEntry()

    if not gameData then
        return nil
    end

    if IsMobile and gameData.Mobile then
        return gameData.Mobile
    end

    return gameData.PC or gameData.Mobile
end

local function LaunchGameScript(scriptUrl)
    task.spawn(function()
        local success, err = pcall(function()
            local code = game:HttpGet(
                scriptUrl .. "?nocache=" .. tostring(os.time())
            )

            loadstring(code)()
        end)

        if not success then
            warn("[KOSMOS LOADER ERROR]: " .. tostring(err))
        end
    end)
end

--============================================================
-- TELEPORT SUPPORT
--============================================================

local function QueueLoaderOnTeleport()
    local queueFn =
        (syn and syn.queue_on_teleport)
        or queue_on_teleport
        or (fluxus and fluxus.queue_on_teleport)

    if not queueFn then
        warn("[KOSMOS] queue_on_teleport unavailable")
        return
    end

    if not LOADER_URL
        or LOADER_URL == ""
        or LOADER_URL:find("INSERISCI") then
        warn("[KOSMOS] Configure LOADER_URL")
        return
    end

    queueFn(
        ('loadstring(game:HttpGet("%s?nocache=" .. tostring(os.time())))()')
        :format(LOADER_URL)
    )
end

local function StartGame(scriptUrl)
    QueueLoaderOnTeleport()
    LaunchGameScript(scriptUrl)
end

--============================================================
-- KEY VERIFICATION
--============================================================

local function VerifyKeyOnline(userKey)
    local success, response = pcall(function()
        return game:HttpGet(
            JSON_KEYS_URL .. "?nocache=" .. tostring(os.time())
        )
    end)

    if not success or not response then
        return false, "Database connection error!"
    end

    local dbSuccess, keysData = pcall(function()
        return HttpService:JSONDecode(response)
    end)

    if not dbSuccess or type(keysData) ~= "table" then
        return false, "Invalid key database format!"
    end

    local keyInfo = keysData[userKey]

    if not keyInfo then
        return false, "Invalid or non-existent key!"
    end

    if keyInfo.used == true
        and keyInfo.hwid ~= ""
        and keyInfo.hwid ~= HWID then
        return false, "Key already used on another device!"
    end

    SaveKeyLocally(userKey)

    return true, "Authentication successful!"
end

--============================================================
-- AUTO LOGIN
--============================================================

local savedKey = GetSavedKey()

if savedKey then
    local isValid = VerifyKeyOnline(savedKey)

    if isValid then
        local gameScriptUrl = GetScriptForCurrentGame()

        if gameScriptUrl then
            SendAuthLog(savedKey)
            StartGame(gameScriptUrl)
            return
        end
    else
        DeleteSavedKey()
    end
end

