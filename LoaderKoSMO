local LOADER_URL = "INSERISCI_URL_RAW_DEL_LOADER"
--============================================================
-- DEVICE DETECTION ENGINE
--============================================================
local function IsMobileDevice()
    local hasTouch = UserInputService.TouchEnabled
    local hasMouse = UserInputService.MouseEnabled
    local hasKeyboard = UserInputService.KeyboardEnabled
    if hasTouch and not hasMouse then
        return true
    elseif GuiService:IsTenFootInterface() then
        return false -- Console / TV
    elseif hasTouch and (not hasKeyboard or UserInputService.GyroscopeEnabled or UserInputService.AccelerometerEnabled) then
        return true
    end
    return false
end
local IsMobile = IsMobileDevice()
