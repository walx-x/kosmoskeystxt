RainConnection = RunService.RenderStepped:Connect(function(dt)
    local safeDt = math.min(dt, 0.05)
    for _, d in ipairs(raindrops) do
        d.y = d.y + (d.speed * safeDt)
        d.x = d.x - (d.drift * safeDt)

        if d.y > RAIN_H + 10 then
            d.y = -d.len - math.random(5, 25)
            d.x = math.random(0, RAIN_W + 35)
        end

        d.obj.Position = UDim2.fromOffset(d.x, d.y)
    end
end)

