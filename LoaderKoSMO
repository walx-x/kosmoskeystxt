local UniverseCache = {}

local function GetUniverseIdFromPlace(placeId)
    if UniverseCache[placeId] then
        return UniverseCache[placeId]
    end

    local ok, universeId = pcall(function()
        local raw = game:HttpGet(
            "https://apis.roblox.com/universes/v1/places/" .. tostring(placeId) .. "/universe"
        )
        return HttpService:JSONDecode(raw).universeId
    end)

    if ok and type(universeId) == "number" then
        UniverseCache[placeId] = universeId
        return universeId
    end

    return nil
end

local function FindGameEntry()
    local placeId = game.PlaceId
    local gameId = game.GameId

    if SupportedGames[placeId] then
        return SupportedGames[placeId]
    end

    if ExtraUniverses[gameId] then
        return ExtraUniverses[gameId]
    end

    for knownPlaceId, data in pairs(SupportedGames) do
        if GetUniverseIdFromPlace(knownPlaceId) == gameId then
            return data
        end
    end

    return nil
end

--============================================================
-- FILE MANAGEMENT & GAME LAUNCHER
--============================================================

local function GetSavedKey()
    if isfile and readfile and isfile(KEY_FILE) then
        local success, result = pcall(function()
            return readfile(KEY_FILE)
        end)
        if success and result then
            return result:gsub("%s+", "")
        end
    end
    return nil
end

local function SaveKeyLocally(key)
    if writefile then
        pcall(function()
            writefile(KEY_FILE, key)
        end)
    end
end

local function DeleteSavedKey()
    if delfile and isfile and isfile(KEY_FILE) then
        pcall(function()
            delfile(KEY_FILE)
        end)
    end
end

local function GetScriptForCurrentGame(rank)
    local gameData = FindGameEntry()
    if not gameData then return nil end

    local platformData = (IsMobile and gameData.Mobile) or gameData.PC or gameData.Mobile
    if not platformData then return nil end

    -- Backward compatibility if a game entry uses a direct URL string
    if type(platformData) == "string" then
        return platformData ~= "" and platformData or nil
    end

    if type(platformData) == "table" then
        local cleanRank = NormalizeRank(rank)
        if cleanRank == "Pro" then
            local url = platformData.Pro or platformData.pro or platformData.Standard or platformData.standard
            return (type(url) == "string" and url ~= "") and url or nil
        else
            local url = platformData.Standard or platformData.standard
            return (type(url) == "string" and url ~= "") and url or nil
        end
    end

    return nil
end

local function LaunchGameScript(scriptUrl)
    task.spawn(function()
        local success, err = pcall(function()
            local code = game:HttpGet(scriptUrl .. "?nocache=" .. tostring(os.time()))
            loadstring(code)()
        end)
        if not success then
            warn("[KOSMOS LOADER ERROR]: " .. tostring(err))
        end
    end)
end

local function QueueLoaderOnTeleport()
    local queueFn =
        (syn and syn.queue_on_teleport)
        or queue_on_teleport
        or (fluxus and fluxus.queue_on_teleport)

    if not queueFn or not LOADER_URL or LOADER_URL == "" then
        return
    end

    queueFn(
        ('loadstring(game:HttpGet("%s?nocache=" .. tostring(os.time())))()')
        :format(LOADER_URL)
    )
end

local function StartGame(scriptUrl)
    QueueLoaderOnTeleport()
    LaunchGameScript(scriptUrl)
end

--============================================================
-- KEY VERIFICATION & HWID AUTO-LOGIN
--============================================================

local function FetchKeysDatabase()
    local success, response = pcall(function()
        return game:HttpGet(JSON_KEYS_URL .. "?nocache=" .. tostring(os.time()))
    end)

    if not success or not response then
        return nil, "Database connection error!"
    end

    local dbSuccess, keysData = pcall(function()
        return HttpService:JSONDecode(response)
    end)

    if not dbSuccess or type(keysData) ~= "table" then
        return nil, "Invalid key database format!"
    end

    return keysData, nil
end

local function CheckAutoLoginByHWID()
    local keysData = FetchKeysDatabase()
    if not keysData then
        return nil, nil
    end

    -- 1. Check locally saved key first
    local savedKey = GetSavedKey()
    if savedKey and type(keysData[savedKey]) == "table" then
        local info = keysData[savedKey]
        if info.used == true and tostring(info.hwid or "") == tostring(HWID) then
            return savedKey, NormalizeRank(info.rank)
        else
            DeleteSavedKey()
        end
    end

    -- 2. Direct auto-login by matching HWID in the GitHub JSON database
    for k, info in pairs(keysData) do
        if type(info) == "table"
            and info.used == true
            and tostring(info.hwid or "") ~= ""
            and tostring(info.hwid) == tostring(HWID)
        then
            SaveKeyLocally(k)
            return k, NormalizeRank(info.rank)
        end
    end

    return nil, nil
end

local function VerifyKeyOnline(userKey)
    local keysData, errMsg = FetchKeysDatabase()
    if not keysData then
        return false, errMsg, nil
    end

    local keyInfo = keysData[userKey]
    if not keyInfo or type(keyInfo) ~= "table" then
        return false, "Invalid or non-existent key!", nil
    end

    -- Reject manual entry if the key is already bound (used == true or hwid_bound == "yes")
    local alreadyBound = (keyInfo.used == true)
        or (tostring(keyInfo.hwid_bound or ""):lower() == "yes")
        or (tostring(keyInfo.hwid or "") ~= "")

    if alreadyBound then
        return false, "Key already redeemed! Bound HWID logs in automatically.", nil
    end

    SaveKeyLocally(userKey)
    return true, "Authentication successful!", NormalizeRank(keyInfo.rank)
end

--============================================================
-- AUTO LOGIN EXECUTION
--============================================================

local autoKey, autoRank = CheckAutoLoginByHWID()

if autoKey then
    local gameScriptUrl = GetScriptForCurrentGame(autoRank)
    if gameScriptUrl then
        SendAuthLog(autoKey, autoRank)
        StartGame(gameScriptUrl)
        return
    end
end

